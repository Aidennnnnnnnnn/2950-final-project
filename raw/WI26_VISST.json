essionBeginDt": "01/02/2026", "sessionEndDt": "01/17/2026", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "The importance of sports to American society and popular culture cannot be denied, and this seminar will study sports films' vital significance in representing the intersection of sports, history, and social identities. This seminar explores how the role of competition between individuals and teams in sports films relate to the competing discourses on race, gender, class, and sexuality in society at large. Additionally, we will examine how social issues are understood in sporting terms and concepts, such as: the hero and the underdog; urban and rural; natural talent versus hard work; and the individual versus team identity. (HTC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026WI, 2025WI, 2024WI, 2023WI", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2916, "crseId": 359688, "crseOfferNbr": 3, "subject": "VISST", "catalogNbr": "2550", "titleShort": "Intro. to Latin American Art", "titleLong": "Introduction to Latin American Art", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "LA-AG", "descr": "AG-Literature & the Arts", "