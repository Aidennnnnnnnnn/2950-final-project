his Winter Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/04/2027", "endDt": "01/22/2027", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "ALC-AS", "descr": "AS-Arts, Literat, and Culture", "descrformal": "AS-Arts, Literature, and Culture", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "LA-AG", "descr": "AG-Literature & the Arts", "descrformal": "AG-Literature and the Arts", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "WS", "sessionBeginDt": "01/04/2027", "sessionEndDt": "01/23/2027", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "The massive success of contemporary novel and film adaptations like Hunger Games, Divergent, Twilight and Fifty Shades of Grey as well as television series such as Scandal have generated new interest in media targeted to female audiences. Historically considered a low-form genre, women's media was not considered a legitimate object of academic study until the 1970s and 1980s when feminist media scholars shed crucial light on low form texts such as daytime soaps, Harlequin romance novels, and family melodramas, insisting that each impacted female audiences in a multitude of surprising and significant ways. Through an analysis of historical and contemporary readings, films, and televisual texts, we will explore how media designed for women specifically targets women viewers. We will identify the current debates around women's spectatorship. We will evaluate and offer a multitude of pleasures. (PMA-HTC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2025FA, 2025WI", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-10-15T19:07:30-0400"}}