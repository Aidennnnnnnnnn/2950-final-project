entsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W3", "sessionBeginDt": "07/13/2026", "sessionEndDt": "07/31/2026", "sessionLong": "Three Week - Three", "exploreCriteriaIds": []}], "description": "This course is a broad introduction to the field of sociology. Course materials are designed to illustrate the distinctive features of the sociological perspective and to start you thinking sociologically about yourself and the broader social world. To think sociologically is to recognize that being embedded in the world constrains behavior, and that individuals are both social actors and social products. To think sociologically is also to recognize that our contemporary world, with its enduring cultural, political, and economic institutions, is as much a social product as we are. We will begin by covering theoretical and methodological foundations of the sociological perspective.  We will go on to explore the concept of social stratification and will survey primary axes of social difference. In the second half of the course we will look more closely at how individuals relate to each other, how social inequality is enacted and reinforced in everyday life, and at the way in which the organization of social life shapes individuals and groups, such as through social networks, residential neighborhoods, schooling, families, and on-line communication.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffer