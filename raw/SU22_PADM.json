ribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: EMPA students.", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will apply tools for evaluating financial statements in the nonprofit sector.", "Students will evaluate debt financing as a financial management strategy, including how debt financing impacts financial flexibility, financing techniques, bond ratings, and coverage ratios.", "Students will evaluate frameworks for nonprofit management, including frameworks for risk management, auditing, conflict of interest, organizational governance, and partnership/alliance-building.", "Students will draft three short, analytical papers on interpreting financial ratios for a college, analyzing a budget for a hospital, and recommending a merger of several nonprofits."], "acadCareer": "GR", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 372602, "crseOfferNbr": 1, "subject": "PADM", "catalogNbr": "5434", "titleShort": "Fundraising", "titleLong": "Fundraising", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1608, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/30/2022", "endDt": "08/20/2022", "instructors": [{"instrAssignSeq": 1, "netid": "jeg68", "firstName": "Joe", "middleName": "", "lastName": "Grasso"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/30/2022", "endDt": "08/20/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGra