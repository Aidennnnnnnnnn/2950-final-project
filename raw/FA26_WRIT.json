mplete at least 4 major writing assignments. This course places greater emphasis on in-class writing, one-on-one conferences with the instructor, peer workshopping, discussion, and learning to talk about how different types of writing work. Students will engage diverse course materials (journalism, scholarly articles, podcasts, films, etc.) on topics like art, literature, and relevant social issues to explore ideas about a text, write for specific audiences, and develop creativity, style, and voice.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2025FA, 2024FA, 2023FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 353946, "crseOfferNbr": 1, "subject": "WRIT", "catalogNbr": "1390", "titleShort": "Special Topics in Writing", "titleLong": "Special Topics in Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1004, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/24/2026", "endDt": "12/07/2026", "instructors": [{"instrAssignSeq": 1, "netid": "thc33", "firstName": "Tracy", "middleName": "Hamler", "lastName": "Carrick"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campu