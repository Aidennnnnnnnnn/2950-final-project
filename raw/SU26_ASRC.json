wn into a global movement. Youth around the world not only consume hip hop; they also create their own, adapting hip hop music, texts, dance, and visual culture to local realities. This course traces the ongoing connections between hip hop's roots in the cultural expression of marginalized African American and Latinx youth in the postindustrial urban United States, its contemporary relationship to US popular culture, and its routes around the globe, where diverse practitioners mobilize its beats, rhymes, and visual culture to address experiences of oppression and displacement, celebrate life, and agitate for social justice. (HC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": "AMST 2371, ASRC 2370, MUSIC 2370, MUSIC 3490", "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026WI, 2025SU, 2025WI", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-08-16T19:07:12-0400"}}