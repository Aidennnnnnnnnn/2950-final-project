leName": "C", "lastName": "Moon"}], "pattern": "MTWRF", "facilityDescr": "Goldwin Smith Hall 158", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH158", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "03:15PM", "timeEnd": "04:45PM", "startDt": "06/25/2018", "endDt": "07/13/2018", "instructors": [], "pattern": "TR", "facilityDescr": "Goldwin Smith Hall 158", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH158", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/25/2018", "endDt": "07/13/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "1615", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This course offers a survey of modern political theory in the West.\u00a0 We will examine some of the persistent dilemmas of political modernity and the attempts of several canonical political theorists to respond to them: Machiavelli, Hobbes, Locke, Rousseau, Burke, Mill, Marx, and Nietzsche.\u00a0 In each case, we will attend to the particular crises these theorists addressed in their work\u2014such as the European wars of religion, the English Civil War, colonialism, the French Revolution, and industrial capitalism\u2014as well as the broader philosophical and political issues they continue to pose to us now.\u00a0 Our approach will be both historical and conceptual, in other words, with the hopes of providing students with a nuanced but clear understanding of political theory as a distinctive form of political inquiry.", "catalogBreadth": "(HB)", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "PHIL 1920 can be taken in sequence with PHIL 1410\u00a0.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 353988, "crseOfferNbr": 1, "subject": "PHIL", "catalogNbr": "2410", "titleShort": "Ethics", "titleLong": "Ethics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1800, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/05/2018", "endDt": "08/07/2018", "instructors": [], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ELMIRA", "locationDescr": "Elmira, NY", "startDt": "06/05/2018", "endDt": "08/07/2018", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This course is intended to introduce and explore some of the big questions about the content, scope, and nature of morality. The first half of the course will focus on various first-order ethical theories, which offer criteria of morally right action. These will include consequentialist and deontological approaches, and also broadly virtue-theoretic approaches, which place more emphasis on the notion of moral character and/or are critical of focusing exclusively on what one ought to do as opposed to who one ought to be. The second half of the course will examine some of the more abstract questions about the nature of morality which are the province of twentieth-century metaethics. What is the nature of moral properties? Where in the world might they be located? Are they objective, subjective, and/or relative to particular times and places? What is the connection between morality, moral judgments, and being motivated to act morally? Interspersed with these theoretical ethical issues will be more concrete ethical questions about what to do as individuals in an often unjust social world.", "catalogBreadth": "", "catalogDistr": "(KCM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2018-09-16T19:14:21-0400", "catalogDttm": "2018-06-14T19:15:33-0400"}}