erstanding of attention, memory, visual perception, learning, problem solving, language comprehension, and consciousness.\u00a0", "catalogBreadth": "", "catalogDistr": "(KCM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, summer (6 week session).", "catalogComments": "A 1 credit Writing in the Majors sections is available,\u00a0PHIL 1911.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 351397, "crseOfferNbr": 2, "subject": "PHIL", "catalogNbr": "1920", "titleShort": "Intro To Modern Pol Theory", "titleLong": "Introduction to Modern Political Theory", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1202, "meetings": [{"classMtgNbr": 1, "timeStart": "10:30AM", "timeEnd": "12:15PM", "startDt": "06/25/2018", "endDt": "07/13/2018", "instructors": [{"instrAssignSeq": 2, "netid": "am63", "firstName": "Alexander", "middleName": "C", "lastName": "Moon"}], "pattern": "MTWRF", "facilityDescr": "Mcgraw Hall 165", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG165", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "03:00PM", "timeEnd": "04:15PM", "startDt": "06/25/2018", "endDt": "07/13/2018", "instructors": [], "pattern": "MW", "facilityDescr": "Mcgraw Hall 165", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG165", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=654"}], "campus": "M