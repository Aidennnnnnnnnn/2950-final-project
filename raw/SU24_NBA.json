ance to change, and using organizational culture to promote innovation.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-12-09T19:39:29-0500", "catalogDttm": "2024-07-23T08:36:15-0400"}}