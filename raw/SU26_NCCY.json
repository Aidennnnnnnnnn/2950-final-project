iteriaIds": []}], "description": "Succeeding in any business leadership role requires you to think critically, and make quality decisions, even in the face of challenges such as imperfect/incomplete information, changing and unforeseen circumstances, and human nature in all of its complexity and unpredictability. Major content themes of this course focus on constructing a persuasive argument and deconstructing arguments made by others; recognizing and avoiding reasoning flaws and the forces that make us most susceptible to such flaws; approaching business problems systematically and thoroughly; and producing a problem solution that is (a) well-reasoned; (b) likely to be well-received by ultimate decision makers; and (c) able to be implemented successfully.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025SU, 2024SU, 2023SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 366661, "crseOfferNbr": 1, "subject": "NCCY", "catalogNbr": "5060", "titleShort": "Managerial Finance", "titleLong": "Managerial Finance", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1765, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "11:50AM", "startDt": "07/27/2026", "endDt": "08/03/2026", "instructors": [{"instrAssig