atalogBreadth": "(GB)", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 357918, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3128", "titleShort": "America's Changing Faces", "titleLong": "America's Changing Faces", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1532, "meetings": [{"classMtgNbr": 1, "timeStart": "07:00PM", "timeEnd": "08:55PM", "startDt": "06/05/2017", "endDt": "07/28/2017", "instructors": [{"instrAssignSeq": 6, "netid": "klb297", "firstName": "Katie", "middleName": "Crosley", "lastName": "Beem"}, {"instrAssignSeq": 3, "netid": "ds90", "firstName": "David", "middleName": "", "lastName": "Silbey"}], "pattern": "R", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Washington, DC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1745"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "DC", "locationDescr": "Washington, DC", "startDt": "06/05/2017", "endDt": "07/28/2017", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3128", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/31/2017", "sessionEndDt": "08/08/2017", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "As new generations of leaders emerge in America's political, economic, educational, and cultural institutions (for good and ill), a national conversation about what constitutes leadership has continued.\u00a0 This course will examine the idea of that leadership at the national, community, and personal levels to understand the interactions between different kinds of leadership, how it connects to ideas of citizenship, communal and political engagement, and how generations shift their ideas of leadership.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(AM)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 359631, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3150", "titleShort": "The Amer Legal System", "titleLong": "The American Legal System", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1214, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "06/05/2017", "endDt": "07/14/2017", "instructors": [{"instrAssignSeq": 3, "netid": "ces78", "firstName": "Charles", "middleName": "Evan", "lastName": "Stewart"}], "pattern": "MTWRF", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1747."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "CENYC", "locationDescr": "Continuing Ed in NYC", "startDt": "06/05/2017", "endDt": "07/14/2017", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/31/2017", "sessionEndDt": "08/08/2017", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This course offers a comprehensive introduction to the American legal system, its roots in natural and common law, the purposes/values it serves (e.g., resolution of private grievances; punishment of offenses against the polity and individuals; preservation, development, and limitation of individual and group rights; and facilitation of commerce and private agreements), and the roles of the judiciary, legislature, and private parties. The course is taught using the Socratic method employed at most US law schools and introduces students to fundamental concepts and techniques used by attorneys and courts in analyzing cases, interpreting statutes, and determining disputes. As in law school, students are expected to read assigned materials before each class meeting and to participate actively in class discussions. For additional information, see the Summer Session website.\n\u00a0", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 351429, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3323", "titleShort": "Modern European Politics", "titleLong": "Modern European Politics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1115, "meetings": [{"classMtgNbr": 1, "timeStart": "08:00AM", "timeEnd": "06:00PM", "startDt": "05/28/2017", "endDt": "06/17/2017", "instructors": [{"instrAssignSeq": 6, "netid": "reb356", "firstName": "Robin", "middleName": "E", "lastName": "Best"}, {"instrAssignSeq": 5, "netid": "jdh293", "firstName": "Jason", "middleName": "", "lastName": "Hecht"}, {"instrAssignSeq": 3, "netid": "keb11", "firstName": "K.E.", "middleName": "", "lastName": "von Wittelsbach"}, {"instrAssignSeq": 4, "netid": "crw12", "firstName": "Christopher", "middleName": "Robert", "lastName": "Way"}], "pattern": "MTWRFS", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Turin, Italy. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1935."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "TURIN", "locationDescr": "Turin, Italy", "startDt": "05/28/2017", "endDt": "06/17/2017", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "SOC", "catalogNbr": "3310", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/31/2017", "sessionEndDt": "08/08/2017", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Introduction to politics and political systems in Western Europe.\u00a0 Starts with a brief history of the consolidation of West European democracies before and after World War II. Discusses core theoretical concepts guiding the comparative analysis of political systems. The main part of the course consists of a discussion of the political cultures, parties, electoral systems, and current problems confronting the political systems of various countries focusing on Italy which is treated in depth. The course concludes with an analysis of the European Union (EU) as political system.", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 368788, "cr