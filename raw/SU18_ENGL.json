riteriaIds": null}], "description": "The past two decades have seen a whole new kind of television: long, multi-plot narratives spun out over many seasons. Some producers have made use of this serial mode to offer complex and inventive models of social analysis. These often share goals with the serial storytelling of the past, including cartoons and novels, and draw on similar strategies. We will watch such series as The Wire, Mad Men, and Game of Thrones, and we will read serialized fictions, including Wilkie Collins' page-turner, The Woman in White, in the spring, and other texts in the summer.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 352966, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "4810", "titleShort": "Advanced Verse Writing", "titleLong": "Advanced Verse Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1191, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "12:45PM", "startDt": "05/24/2018", "endDt": "06/22/2018", "instructors": [{"instrAssignSeq": 1, "netid": "sv19", "firstName": "Stephanie", "middleName": "", "lastName": "Vaughn"}], "pattern": "MTWRF", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Rome. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For detail