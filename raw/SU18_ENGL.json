Renaissance culture. Our study will include attention to dramatic forms, Shakespeare's themes, and social and historical contexts, including early modern English theater history. The course combines lectures and hands-on work in weekly discussions focused on performance, close reading, and questions raised by the plays. We will also view some film adaptations of Shakespeare. Fall semester plays include The Merchant of Venice, Twelfth Night, The Tempest, Othello, King Lear, Richard II, Henry IV Part One, and Henry V. Summer semester plays may vary.", "catalogBreadth": "(HB)", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, summer.", "catalogComments": "May be used as one of the three pre-1800 courses required of English majors.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 352756, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "2800", "titleShort": "Intro to Creative Writing", "titleLong": "Introduction to Creative Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1175, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "11:30AM", "startDt": "05/30/2018", "endDt": "06/22/2018", "instructors": [{"instrAssignSeq": 4, "netid": "eq25", "firstName": "Ernesto", "middleName": "", "lastName": "Quinonez"}], "pattern": "MTWRF", "facilityDescr": "Goldwin Smith Hall 181", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH181", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by t