 "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "3W1", "sessionBeginDt": "06/01/2026", "sessionEndDt": "06/18/2026", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "Data scientists often present information to disseminate their findings. This course introduces theories and applications of communicating with data, with an emphasis on visualizations. To support this approach, we will focus on the what, why, and how of data visualization. What focuses on specific types of visualizations for a particular purpose, as well as tools for constructing these plots. In how we will focus on the process of generating a data visualization from pre-processing the raw data, mapping attributes of the data to plot aesthetics, strategically determining how to define the visual encoding of the data for maximal accessibility, and finalizing the visualization to consider the importance of visual appeal. In why we discuss the theory tying together the how and the what, and consider empirical evidence of best-practices in data communication.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "INFO 2950 or INFO 2951.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Implement principles of designing and creating effective data visualizations.", "Evaluate, critique, and improve upon one's own and others' data visualizations based on how good a job the visualization does for communicating a message clearly and correctly.", "Post-process and refine plots for effective communication.", "Master using R and a variety of modern data visualization packages to reproducibly create data visualizations."], "acadCareer": "UG", "acadGroup": "EN", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026SP, 2025SP, 2024SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 365490, "crseOfferNbr": 2, "subject": "INFO", "catalogNbr": "4301", "titleShort": "Ethics in New Media", "titleLong": "Ethics in New Media, Technology, and Communication", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "ETH-AG", "descr": "AG-Ethics", "descrformal": "AG-Ethics", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(CA-AG, ETH-AG)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1469, "meetings": [{"classMtgNbr": 1, "timeStart": "09:30AM", "timeEnd": "12:15PM", "startDt": "06/22/2026", "endDt": "07/10/2026", "instructors": [{"instrAssignSeq": 3, "netid": "mes476", "firstName": "Megan", "middleName": "", "lastName": "Sawey"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/22/2026", "endDt": "07/10/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseA