t approaches. Students then draw from knowledge of the biology of these key parasites in order to make inferences about related organisms. This course is intended as a core course for students enrolled in the Master of Professional Studies (MPS) in Veterinary Parasitology.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: Master of Professional Studies (MPS) students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2025FA, 2024FA, 2023FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 370053, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7446", "titleShort": "Cpstne Proj II: System Lit Rev", "titleLong": "Capstone Project II: Systematic Literature Review", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 2652, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/24/2026", "endDt": "12/07/2026", "instructors": [{"instrAssignSeq": 2, "netid": "jkk5", "firstName": "Jennifer", "middleName": "K.", "lastName": "Ketzis"}, {"instrAssignSeq": 1, "netid": "al33", "firstName": "Araceli", "middleName": "", "lastName": "Lucio-Forster"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/24/2