akers for each semester can be found by going to the CVM Department of Microbiology and Immunology website. Requirement for graduate students in the field of Immunology and Infectious Disease in the BBS program.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: graduate students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2026SP, 2025FA, 2025SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 368360, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7418", "titleShort": "Parasite Diagnostic Methods", "titleLong": "Parasite Diagnostic Methods", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 2648, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "08/24/2026", "endDt": "12/07/2026", "instructors": [{"instrAssignSeq": 1, "netid": "al33", "firstName": "Araceli", "middleName": "", "lastName": "Lucio-Forster"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/24/2026", "endDt": "12/19/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 2, "unitsMaximum": 2, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course will present an overview of parasitologic diagnostic methods including ones used commonly in clinical settings, advanced methods used for specific parasite diagnoses, methods used in research, and methods currently under development. The principles and methodologies behind these methods are presented. The advantages and disadvantages of different methods are examined. This course is intended as a core course for students enrolled in the Master of Professional Studies (MPS) in Veterinary Parasitology.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: Master of Professional Studies (MPS) students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2025FA, 2024FA, 2023FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 368381, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7435", "titleShort": "US Govt and Animal Health", "titleLong": "