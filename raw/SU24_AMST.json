scr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/03/2024", "endDt": "06/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "3141", "type": "C"}], "sessionCode": "3W1", "sessionBeginDt": "06/03/2024", "sessionEndDt": "06/21/2024", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "The United States stands alone among Western, industrialized countries with its persistent, high rates of incarceration, long sentences, and continued use of the death penalty. This \"American exceptionalism\" -- the turn to mass incarceration -- has been fostered by the use of sharply-delineated categories that define vast numbers of people as outlaws and others as law-abiding. These categories that are based on ideas of personal responsibility and\u00a0assumptions about race are modified somewhat by a liberal commitment to human rights.\u00a0\u00a0 Our purpose in this course is to understand how such ideas have taken root and to locate the consequences of these ideas for policy and practice.\u00a0", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalog