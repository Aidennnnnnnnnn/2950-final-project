eption and at can fuel social change, from contexts ranging from the civil rights movement, to US imperialist projects, to the HIV/AIDs crisis, the COVID-19 pandemic, movements like BlackLivesMatter and MeToo, and struggles for trans rights.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 359630, "crseOfferNbr": 2, "subject": "AMST", "catalogNbr": "3071", "titleShort": "Enduring Global & Amer Issues", "titleLong": "Enduring Global and American Issues", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "080", "classNbr": 1171, "meetings": [{"classMtgNbr": 1, "timeStart": "06:30PM", "timeEnd": "09:50PM", "startDt": "06/04/2024", "endDt": "07/25/2024", "instructors": [{"instrAssignSeq": 1, "netid": "ds90", "firstName": "David", "middleName": "", "lastName": "Silbey"}], "pattern": "TR", "facilityDescr": "Wolpe Center 118", "bldgDescr": "Wolpe Center", "facilityDescrshort": "WLP118", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "DC", "locationDescr": "Washington, DC", "startDt": "06/04/2024", "endDt": "07/29/2024", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum"