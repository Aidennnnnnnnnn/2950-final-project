 in order to allow ample time for discussion and for personal attention to student writing.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 352638, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "1132", "titleShort": "FWS:The Personal Essay", "titleLong": "FWS:The Personal Essay", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1133, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "09:45AM", "startDt": "06/22/2020", "endDt": "07/31/2020", "instructors": [{"instrAssignSeq": 5, "netid": "kda24", "firstName": "Kevin", "middleName": "D.", "lastName": "Attell"}], "pattern": "MTWRF", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=600"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/22/2020", "endDt": "07/31/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "m