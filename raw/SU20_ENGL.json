103", "classNbr": 1135, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "11:15AM", "startDt": "06/22/2020", "endDt": "07/31/2020", "instructors": [{"instrAssignSeq": 5, "netid": "sj583", "firstName": "Samson", "middleName": "", "lastName": "Jardine"}], "pattern": "MTWRF", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=600"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/22/2020", "endDt": "07/31/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/22/2020", "sessionEndDt": "07/31/2020", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "In \"The Personal Essay,\" our topics are autobiographical in their origins; we write from personal experience, to think about it and to articulate it, in a style useful in all modes of college-admission and college-work. Our writing practice is both \"creative\" and \"analytical.\" We discover how writers use drafting and revision as a process of thinking, and in weekly workshops we practice the kind of revision that can make us more independent as writers and more capable of giving helpful suggestions to friends who are also writers. The most important texts for the course are the essays of students enrolled in it; but we also read and discuss personal memoirs. This seminar offers students from diverse backgrounds a forum in which to move beyond accustomed boundaries, finding agency not only through use of the first-person voice but through increased confidence in their abilities as writers.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 370061, "crseOfferNbr": 4, "subject": "ENGL", "catalogNbr": "2703", "titleShort": "Thinking Media", "titleLong": "Thinking Media", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1493, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "07/13/2020", "endDt": "07/31/2020", "instructors": [{"instrAssignSeq": 1, "netid": "jb358", "firstName": "Jeremy", "middleName": "", "lastName": "Braddock"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3345"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/13/2020", "endDt": "07/31/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "COML", "catalogNbr": "2703", "type": "C"}, {"subject": "GERST", "catalogNbr": "2703", "type": "C"}, {"subject": "PMA", "catalogNbr": "2703", "type": "C"}], "sessionCode": "3W3", "sessionBeginDt": "07/13/2020", "sessionEndDt": "07/31/2020", "sessionLong": "Three Week - Three", "exploreCriteriaIds": null}], "description": "From hieroglyphs to HTML, ancient poetry to audiotape, and Plato's cave to virtual reality, \"Thinking Media\" offers a multidisciplinary introduction to the most influential media formats of the last three millennia. Featuring an array of guests from across Cornell, including faculty from Communication, Comparative Literature, English, German Studies, Information Science, Music, and Performing &amp; Media Arts, the course will present diverse perspectives on how to think with, against, and about media in relation to the public sphere and private life, archaeology and science fiction, ethics and aesthetics, identity and difference, labor and play, knowledge and power, expression and surveillance, and the generation and analysis of data.", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Taught in English. Although designed as a three-credit course, students may elect to take this course for four credits by completing additional research components (including a piece of extended writing) and attending extra sessions, which may enable the course to satisfy certain elective requirements in various departments and programs. Please consult the instructor for further details.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2021-02-11T19:14:03-0500", "catalogDttm": "2020-06-28T19:15:08-0400"}}