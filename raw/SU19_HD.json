"componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Broad overview of theories, research, and issues in the study of human development during adolescence and emerging adulthood. Focuses on the major biological, cognitive, and social changes during adolescence; the psychosocial issues of adolescence, including identity, autonomy, intimacy, sexuality, achievement, and problems; and the contexts in which adolescent development occurs, particularly families, peer groups, schools, work, and popular culture. Discusses empirical research, theories, case studies of the lives of real adolescents, and, to a lesser degree, public policies.", "catalogBreadth": "", "catalogDistr": "(SBA-HE)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students demonstrate understanding of theories and research findings from psychology, sociology, and neuroscience, which apply to adolescence."], "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 351513, "crseOfferNbr": 2, "subject": "HD", "catalogNbr": "2600", "titleShort": "Intro to Personality", "titleLong": "Introduction to Personality", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1221, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "