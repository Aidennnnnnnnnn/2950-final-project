en to the role of the state, market, non-governmental actors and communities in planning, building, and governing of cities. The course investigates opportunities and challenges facing cities, including but not limited to unprecedented increases in inequality, migration, climate change, informality, and access to shelter and core infrastructure.\u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(EC-SAP, EC-SEAP)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 351983, "crseOfferNbr": 1, "subject": "CRP", "catalogNbr": "5080", "titleShort": "Intro to GIS for Planners", "titleLong": "Introduction to GIS for Planners", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1511, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "02:00PM", "startDt": "05/31/2022", "endDt": "06/17/2022", "instructors": [{"instrAssignSeq": 4, "netid": "wq43", "firstName": "Waishan", "middleName": "", "lastName": "Qiu"}], "pattern": "MTWRF", "facilityDescr": "Sibley Hall 305", "bldgDescr": "Sibley Hall", "facilityDescrshort": "SBL305", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2219"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/31/2022", "endDt": "06/17/2022", "addConse