esses the student\u2019s ability to put their knowledge and understanding of parasitology laboratory methods and parasite identification into practice. Students will demonstrate their knowledge of laboratory methods and practice parasite identification skills through activities such as identifying parasites using taxonomic keys, selecting laboratory methods based on protocol outlines or disease diagnosis, critiquing methods used in the literature, and writing Standard Operating Procedures (SOPs). This course is intended as an online lab course for students enrolled in the Master of Professional Studies (MPS) in Veterinary Parasitology.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: students in the Master of Professional Studies (MPS) in Veterinary Parasitology program.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "VETMI 7420 and VETMI 7421.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "VM", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 374829, "crseOfferNbr": 1, "subject": "VETMI", "catalogNbr": "7461", "titleShort": "Parasites Without Boundaries", "titleLong": "Parasites Without Boundaries", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1363, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/26/2026", "endDt": "08/15/2026", "instructors": [{"instr