riod, students study a selected mix of short plays, casting monologues, and videos. Students also write their own monologues with the assistance of the professor and/or perform them under the tutelage of Spanish theater actor Jos\u00e9 Luis Pati\u00f1o. Throughout the class, students focus on acquiring and delivering cultural meanings through improved pronunciation, tonality, delivery, and general presentation of oral work and performances.", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: SPAN 2095.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 359172, "crseOfferNbr": 1, "subject": "SPAN", "catalogNbr": "2180", "titleShort": "Adv Span Writing Workshop", "titleLong": "Advanced Spanish Writing Workshop", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 2014, "meetings": [{"classMtgNbr": 1, "timeStart": "03:10PM", "timeEnd": "04:25PM", "startDt": "05/28/2024", "endDt": "07/05/2024", "instructors": [{"instrAssignSeq": 4, "netid": "rdi9", "firstName": "Roberto", "middleName": "Diego", "lastName": "Ibanez Ricouz"}], "pattern": "MTR", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:00AM", "timeEnd": "03:00PM", "startDt": "05/29/2024", "endDt": "05/29/2024", "instructors": [], "pattern": "W", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}, {"classMtgNbr"