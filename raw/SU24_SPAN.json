, "description": "This course, which is required for the major, is designed to help the learner develop increased accuracy and sophistication in writing in Spanish for academic purposes and continued oral practice in Spanish. To this end, there will be ample writing and revising practice, with a focus on specific grammatical and lexical areas, customized to the needs of the students enrolled in the course.\u00a0 All writing will be based on a particular theme relating to Latin America with a focus on film, literary texts, newspaper readings and conducting an interview.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring.", "catalogComments": "This is a core course for the Spanish major or minor.", "catalogPrereqCoreq": "Prerequisite: SPAN 2095\u00a0or CASE Q++ or permission of instructor required.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 359170, "crseOfferNbr": 1, "subject": "SPAN", "catalogNbr": "2230", "titleShort": "Perspectives on Spain", "titleLong": "Perspectives on Spain", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 2015, "meetings": [{"classMtgNbr": 1, "timeStart": "05:50PM", "timeEnd": "07:10PM", "startDt": "05/28/2024", "endDt": "07/05/2024", "instructors": [{"instrAssignSeq": 4, "netid": "cbl6", "firstName": "Cecelia", "middleName": "", "lastName": "Lawless"}], "pattern": "MTR", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:00AM", "timeEnd": "03:00PM