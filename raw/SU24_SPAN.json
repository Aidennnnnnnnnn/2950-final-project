ng and writing.\u00a0 The course is structured around four thematic units: fashion and art; the natural world; personal relationships; and health. In each unit, we will learn the vocabulary and grammar constructions that are necessary to talk about the unit's topic. Particular emphasis will be placed on the skill of giving and defending opinions. Throughout the semester, we will discuss and analyze a wide variety of art from the Hispanic world, including songs, fashion, visual arts, TV shows, films, performance art, newspaper articles, documentaries, film shorts and podcasts. The overall goal of this course is to develop students' ability to comprehend authentic materials in Spanish and formulate nuanced opinions about those materials.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Winter, Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: SPAN 1120, SPAN 1220, or LPS 45-55.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 359167, "crseOfferNbr": 1, "subject": "SPAN", "catalogNbr": "2090", "titleShort": "Span Intermed Comp&Conv I", "titleLong": "Intermediate Spanish I (Composition and Conversation)", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 2010, "meetings": [{"classMtgNbr": 1, "timeStart": "04:30PM", "timeEnd": "05:45PM", "startDt": "05/28/2024", "endDt": "07/05/2024", "instructors": [{"instrAssignSeq": 3, "netid": "cbl6", "firstName": "Cecelia", "middleName": "", "lastName": "Lawless"}], "pattern": "MTR", "facilityDescr": null, "bldgDescr": null, "