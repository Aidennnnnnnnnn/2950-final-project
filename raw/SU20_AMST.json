ern, industrialized countries with its persistent, high rates of incarceration, long sentences, and continued use of the death penalty. This \"American exceptionalism\" -- the turn to mass incarceration -- has been fostered by the use of sharply-delineated categories that define vast numbers of people as outlaws and others as law-abiding. These categories that are based on ideas of personal responsibility and\u00a0assumptions about race are modified somewhat by a liberal commitment to human rights.\u00a0\u00a0 Our purpose in this course is to understand how such ideas have taken root and to locate the consequences of these ideas for policy and practice.\u00a0", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "Distance learning.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 350666, "crseOfferNbr": 1, "subject": "AMST", "catalogNbr": "3980", "titleShort": "Independent Research", "titleLong": "Independent Research", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 1862, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/01/2020", "endDt": "07/24/2020", "instructors": [{"instrAssignSeq": 1, "netid": "ds90", "firstName": "David", "middleName": "", "lastName": "Silbey"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, 