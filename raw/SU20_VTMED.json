artment of Biomedical Sciences. Working with the attending pathologist, students examine tissue specimens histologically, propose diagnoses, and discuss their interpretations. Students may enroll in this course only through the Office of Student Records within the official add/drop period. All requests to enroll must be accompanied by the Supplemental Enrollment Form indicating Dr. McDonough's approval of the enrollment and the amount of credit to be awarded. Second-year students should not enroll for any term other than summer unless they have actually reserved a January or spring-break slot through Dr. McDonough.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "One or two weeks, approx. eight hours per day for 1 credit per week.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: second-, third-, and fourth-year veterinary students.\u00a0 Second year students must have satisfactorily completed block IV.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "VM", "acadGroup": "VM", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 350945, "crseOfferNbr": 1, "subject": "VTMED", "catalogNbr": "6545", "titleShort": "Sheep & Goat Medicine", "titleLong": "Sheep and Goat Medicine", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1735, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/25/2020", "endDt": "08/16/2020", "instructors": [{"instrAssignSeq": 1, "netid": "mcs8", "firstName": "Mary", "middleName": "Caroline", "lastName": "Smith"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityD