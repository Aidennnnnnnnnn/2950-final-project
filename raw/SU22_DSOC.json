. The goal of this introductory course is to help students gain understandings of the origins, structure, and dynamics of organizations and their relationships to their environment. It is designed to provide an exposure to multiple theories of organizations and within the context of changing technological, social, and political/legal environments and the globalization of the world economy. We will also apply organizational theories to a variety of empirical cases.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": null, "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AG", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-09-01T07:41:12-0400", "catalogDttm": "2022-08-09T08:17:01-0400"}}