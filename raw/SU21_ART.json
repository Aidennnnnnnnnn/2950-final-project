Ids": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["STU"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W3", "sessionBeginDt": "07/12/2021", "sessionEndDt": "07/30/2021", "sessionLong": "Three Week - Three", "exploreCriteriaIds": null}], "description": "Sculpture is distinguishable from other visual arts through its inherent use of space and reliance on an enormous range of materials. It is in our space, it makes us move in a certain way and it makes us want to move in a certain way. Because sculpture is physical like us, we respond to it on a visceral level. Sculpture can also be made out of literally anything, and each \"anything\" already comes with its own meanings and associations. All of these are givens, even before we decide what our work is about. This is what makes sculpture so powerful and exciting, and also so challenging. This course begins by exploring these givens though a number of very specific assignments and discussions. After a level of class-wide proficiency has been attained each student will develop their own line of inquiry and develop highly individualized projects.", "catalogBreadth": "", "catalogDistr": "(LA-AAP)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Free elective for B.F.A. students.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 371162, "crseOfferNbr": 1, "subject": "ART", "catalogNbr": "1104", "titleShort": "Art as Experience: Photo", "titleLong": "Art as Experience: Photography", "crs