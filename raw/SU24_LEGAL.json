nBeginDt": "05/28/2024", "sessionEndDt": "08/17/2024", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Business organizations sometimes intentionally or unintentionally harm human rights either directly or in their association with other organizations that are part of their supply chain. This course will provide examples of where businesses have committed human rights violations. International laws and norms increasingly govern business and human rights. These regulations guide businesses on how to better design better compliance mechanisms to ensure best practices in protecting human rights globally.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 371222, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "5113", "titleShort": "U.S. Antitrust Law and Policy", "titleLong": "U.S. Antitrust Law and Policy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1659, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/06/2024", "endDt": "06/23/2024", "instructors": [{"instrAssignSeq": 1, "netid": "gah7", "firstName": "George", "middleName": "Alan", "lastName": "Hay"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Master of Science Legal Studies students."}], "campus": "MAIN", "campusDescr":