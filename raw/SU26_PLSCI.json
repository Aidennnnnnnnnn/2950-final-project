ine. This course is suitable for life sciences majors.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Describe the role of plants in human health and in social contexts in the past and the present.", "Identify and define the most commonly used medicinal plants across the continents and their bioactive compounds.", "Discuss the processes involved in the isolation of active bio compounds from plants.", "Compare how medicinal plants are used in various cultures, which organ(s) they affect in the human body, how efficacy is measured, and explain in general terms their modes of action.", "Integrate concepts from ethnobotany, biochemistry, pharmacology, toxicology and conservation."], "acadCareer": "UG", "acadGroup": "AG", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025FA, 2025SU, 2024FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 361073, "crseOfferNbr": 1, "subject": "PLSCI", "catalogNbr": "2400", "titleShort": "Green World, Blue Planet", "titleLong": "Green World, Blue Planet", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "BSC-AG", "descr": "AG-Biological Sciences", "descrformal": "AG-Biological Sciences", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "BIO-AG", "descr": "AG-Intr Life Sci/Bio: Bio", "descrformal": "AG-Intr Life Sci/Biology Requirement: Biology", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr