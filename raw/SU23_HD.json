nBeginDt": "06/20/2023", "sessionEndDt": "08/01/2023", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Introduction to Human Development provides a broad and foundational overview of field of human development, starting from conception and ending through process of death and dying. The course will start with an outline and explanation of the lifespan perspective in human development. The biological beginnings of life and prenatal development will serve as the start of the discussion of human development, followed by an exploration of physical, cognitive, and socioemotional development at each subsequent stage within the lifespan (e.g., infancy, early childhood, middle &amp; late childhood, etc.). Discussion of each developmental stage will highlight major research findings and their real-world application.", "catalogBreadth": "", "catalogDistr": "(SBA-HE)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will receive credit for only one course in the following group: HD 1130, HD 1150, HD 1170,\u00a0PSYCH 1131.\u00a0", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Develop a broad but strong base of knowledge surrounding the field of human development and how human development research is conducted.", "Be able to read and understand, critically think about current research in the field of human development and how research can be applied to the real world.", "Gain an understanding about the different developmental stages and what kind of change is occurring across the domains of physical, cognitive, and socioemotional development.", "Consider your beliefs about development before the course and reconsider the beliefs that are not supported by research.", "Find this class fun and interesting, taking what you learned from the course and be able to apply it in your daily life!"], "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 351490, "crseOfferNbr": 3, "subject": "HD", "catalogNbr": "2230", "titleShort": "Intro to Behavioral Neuroscien", "titleLong": "Intro to Behavioral Neuroscience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1118, "meetings": [{"classMtgNbr": 1, "timeStart": "04:00PM", "timeEnd": "05:15PM", "startDt": "06/20/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 6, "netid": "jem547", "firstName": "Jesus", "middleName": "E.", "lastName": "Madrid"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1012"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "08/01/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COGST", "catalogNbr": "2230", "type": "C"}, {"subject": "PSYCH", 