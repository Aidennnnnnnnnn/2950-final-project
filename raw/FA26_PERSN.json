ith the alphabet and number system and expands to include basic and functional topics of everyday use such as speaking about oneself, family and social life, study and work, daily activities, time and routine, likes and dislikes. Functional speaking proficiency in everyday colloquial Persian is integral to all our courses. Expect speaking activities in class on daily basis. The course guides the students towards Novice Low to Novice Mid proficiency levels, based on the ACTFL proficiency scale, depending on individual progress and skill development.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Learn about 400 high-frequency, practical vocabulary units and everyday Persian phraseology.", "Understand and actively participate in conversations on basic topics listed above.", "Read and comprehend basic texts written in Persian script.", "Write brief paragraphs in proper written Persian on the familiar topics covered in class."], "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2025FA, 2024FA, 2023FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 358367, "crseOfferNbr": 1, "subject": "PERSN", "catalogNbr": "1322", "titleShort": "Intermediate Persian-Farsi I", "titleLong": "Intermediate Persian-Farsi I", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "SALANG", "descr": "South Asia Studies Lang", "descrformal": "South Asia Studies Language", "attrDescr": "Exploratory Studies", "at