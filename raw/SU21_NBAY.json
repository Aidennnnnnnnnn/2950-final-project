inimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/31/2021", "sessionEndDt": "08/21/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course will take students through the entire entrepreneurial journey \u2013 opportunity recognition and evaluation, fundamentals of business model design and implementation, building the founding team and hiring early employees, evaluating funding options and acquiring financial resources, managing risk and uncertainty, growth and scaling up, and finally, realizing the (financial as well as personal) value of the venture through exit options. The course will help students learn and apply the lean startup methodology, popular among new digital ventures. We will primarily use case studies of a variety of digital entrepreneurial ventures and case-based exercises to illustrate these concepts and practice real world applications. BEV will equip students with the lean startup toolkit and is primarily designed for students interested in starting, working at, advising, or financing new ventures, but can also be of use to someone interested in leading entrepreneurial innovation in established firms. The final deliverable will be student choice: a take-home case analysis, or a business plan.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 370471, "crseOfferNbr": 1, "subject": "NBAY", "catalogNbr": "6710", "titleShort": "Ethical Dec. Making in Mgmt", "titleLong": "Ethical Decision Making in Management", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1660, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:15PM", "startDt": "08/10/2021", "endDt": "08/13/2021", "instructors": [{"instrAssignSeq": 1, "netid": "dmr42", "firstName": "Dana", "middleName": "M.", "lastName": "Radcliffe"}], "pattern": "TWRF", "facilityDescr": "Breazzano Family Ctr 223", "bldgDescr": "Breazzano Family Ctr for BusEd", "facilityDescrshort": "BRZ223", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "09:00AM", "timeEnd": "12:15PM", "startDt": "08/16/2021", "endDt": "08/17/2021", "instructors": [{"instrAssignSeq": 1, "netid": "dmr42", "firstName": "Dana", "middleName": "M.", "lastName": "Radcliffe"}], "pattern": "MT", "facilityDescr": "Breazzano Family Ctr 223", "bldgDescr": "Breazzano Family Ctr for BusEd", "facilityDescrshort": "BRZ223", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Limited to Summer Johnson MBA students only.\nThis course counts as a Leadership Elective."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/10/2021", "endDt": "08/17/2021", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid-Online and In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/31/2021", "sessionEndDt": "08/21/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Poor moral judgment can ruin a manager's career or even sink a company. In general, an organization cannot survive without the trust of numerous stakeholders, and ethical lapses destroy trust and threaten vital stakeholder relationships. In today's volatile and fiercely competitive business environment, a manager must be able to identify and effectively resolve ethical issues that inevitably arise in the pursuit of business (and career) objectives. This course is designed to enhance students' skills in moral reasoning as it applies to managerial decision making. It thus examines normative concepts and principles that typically enter into moral reasoning and uses those concepts and principles in analyzing real-world cases.\u00a0Discussions are designed to help students understand the moral issues confronting the decision makers in the cases and explore how those issues might be addressed in ethically responsible ways.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: TECH 5310.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2021-09-09T19:14:03-0400", "catalogDttm": "2021-09-09T19:15:17-0400"}}