], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course offers a close look at the language, history and culture of Ukraine, tracing its journey toward independence and statehood. Historical mileposts, along with the role of language and culture in defining Ukraine\u2019s place in the world, are discussed in depth. This is not a course in history or government; the recent complex (often cataclysmic) events in Ukraine are investigated in the context of the everyday life of our contemporaries. How have Ukrainians pursued self-determination through culture and language after decades of oppression and control? We will attempt to understand how historical experiences, cultural traditions, and aspirations for independence have combined to create contemporary Ukraine. Detailed description at https://ukrainian.as.cornell.edu.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2026SP, 2025FA, 2025SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 353937, "crseOfferNbr": 1, "subject": "UKRAN", "catalogNbr": "3300", "titleShort": "Directed Studies", "titleLong": "Directed Studies", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent 