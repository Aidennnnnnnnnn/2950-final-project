im. Justice Reform", "titleLong": "Comparative Perspectives on Criminal Justice Reform", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1952, "meetings": [{"classMtgNbr": 1, "timeStart": "01:15PM", "timeEnd": "02:45PM", "startDt": "07/02/2026", "endDt": "07/17/2026", "instructors": [{"instrAssignSeq": 1, "netid": "jme258", "firstName": "Jessica", "middleName": "M", "lastName": "Eaglin"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "PARIS", "locationDescr": "Paris, France", "startDt": "07/02/2026", "endDt": "07/17/2026", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/26/2026", "sessionEndDt": "08/15/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "The United States maintains an historically distinct prison and correctional population due to both its size and the concentration of its application upon marginalized groups. This course considers various economic, social, legal and political pressures mass incarceration places on criminal law's administration in the United States. It further examines several criminal legal reforms developed in this era from a comparative perspective. Students will consider the ways in which emergent criminal legal practices in the U.S. are unique - and not - in comparison to developments across Europe and Brazil.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Identify and assess various legal issues that specific technologies raise when implemented in the United States.", "Understand how criminal law operates differently in different countries.", "Identify and evaluate different methods of analyzing controversial contemporary issues relating to criminal law.", "Identify and critically think about policy implications that arise in relation to the practical application of specific criminal justice reforms."], "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 375306, "crseOfferNbr": 1, "subject": "LAW", "catalogNbr": "6246", "titleShort": "Comp Contract Law & Automation", "titleLong": "Comparative Contract Law in the Age of Automation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1953, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "04:30PM", "startDt": "07/02/2026", "endDt": "07/17/2026", "instructors": [{"instrAssignSeq": 1, "netid": "eha47", "firstName": "Emad", "middleName": "H", "lastName": "Atiq"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "PARIS", "locationDescr": "Paris, France", "startDt": "07/02/2026", "endDt": "07/17/2026", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/26/2026", "sessionEndDt": "08/15/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Contracts represent the foundation of modern exchange, but their meaning and moral force are shifting under the pressures of standardization and algorithmic mediation. This course compares EU and US approaches to standard-form agreements, algorithmic contracting, and consumer protection. It asks how law should respond when consent, terms, and even promissory performance are machine-generated. Through readings and cases, students shall examine how contract law adapts-or fails to adapt-to automation, and whether classical doctrines of consent, fairness, and enforcement can withstand an era of machine-mediated contracting.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Possess knowledge of the substantive and procedural law required for effective participation.", "Engage effectively in legal research, analysis, and problem solving in a appropriate time frame.", "Possess the practical skills fundamental to exceptional lawyering and client representation.", "Conduct themselves with the highest moral and ethical standards."], "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-08-16T19:07:12-0400"}}