pleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/26/2026", "sessionEndDt": "08/15/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course introduces students to the study of foreign legal systems. It will provide a broad overview of the institutional and conceptual organization of civil law legal systems, comparing them to their common law equivalents in the United States. Substantively, the course will focus on the different approaches to private law and procedure, criminal procedure, administrative law and constitutional law that characterize most contemporary European civil law jurisdictions. Methodologically, the course will teach the most important approaches for engaging in comparative legal analysis, so that students will be in a position to practice and critique them effectively.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025SU, 2024SU, 2023SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 369803, "crseOfferNbr": 1, "subject": "LAW", "catalogNbr": "6244", "titleShort": "Corporate Governance", "titleLong": "Corporate Governance: Corporate Acquisitions and Capital Structure", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1536, "meeting