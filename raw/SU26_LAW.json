m students. For details visit: https://sce.cornell.edu/precollege/program/online."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/22/2026", "endDt": "07/10/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "SAAREA", "descr": "South Asia Studies Area", "descrformal": "South Asia Studies Area", "attrDescr": "Area Studies", "attrDescrShort": "Area Std"}, {"crseAttr": "0009", "crseAttrValue": "PCONLINE", "descr": "Precollege Online", "descrformal": "Precollege Studies Online Program", "attrDescr": "School of Continuing Education", "attrDescrShort": "SCE"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0013", "crseAttrValue": "CU-SBY", "descr": "Sustainability", "descrformal": "Sustainability", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "3887", "type": "B"}], "sessionCode": "3W2", "sessionBeginDt": "06/22/2026", "sessionEndDt": "07/10/2026", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}], "description": "This course will introduce students to the law, theory, and practice of international human rights. Students will think critically about the effectiveness of the international human rights system by examining its successes, failures, and dilemmas in preventing and responding to human rights abuse. Topics covered will include the origins and foundations of international human rights; the role of international, regional, and domestic institutions and actors in enforcing human rights; critiques of the human rights movement; and the relationship of the United States to the international system for the protection of human rights. The course will also explore issues such as the death penalty, women's human rights, migration, climate change, global poverty, racism and xenophobia, and responses to mass atrocities. During in-class activities, students will have the opportunity to step into the shoes of a human rights advocate and work with their classmates to address simulated human rights problems.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025SU, 2024SU, 2024WI", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 370207, "crseOfferNbr": 1, "subject": "LAW", "catalogNbr": "4031", "titleShort": "Intro to Global Study of Law", "titleLong": "Introduction to the Global Study of Law", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1537, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "05:00PM", "startDt": "06/29/2026", "endDt": "07/17/2026", "instructors": [{"instrAssignSeq": 1,