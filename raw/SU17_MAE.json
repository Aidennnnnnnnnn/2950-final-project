s to meet performance specifications on dynamic response."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 368765, "crseOfferNbr": 1, "subject": "MAE", "catalogNbr": "3270", "titleShort": "Mech of Engineering Materials", "titleLong": "Mechanics of Engineering Materials", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1276, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "12:45PM", "startDt": "05/25/2017", "endDt": "07/05/2017", "instructors": [{"instrAssignSeq": 6, "netid": "atz2", "firstName": "Alan", "middleName": "Taylor", "lastName": "Zehnder"}], "pattern": "MTWR", "facilityDescr": "Hollister Hall 312", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS312", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3133."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/25/2017", "endDt": "07/05/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}, {"ssrComponent": "LAB", "ssrComponentLong": "Laboratory", "section": "401", "classNbr": 1277, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "04:30PM", "startDt": "05/25/2017", "endDt": "07/05/2017", "instructors": [{"instrAssignSeq": 6, "netid": "atz2", "firstName": "Alan", "middleName": "Taylor", "lastName": "Zehnder"}], "pattern": "MW", "facilityDescr": "Thurston Hall 101", "bldgDescr