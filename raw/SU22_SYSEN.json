": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "8WK", "sessionBeginDt": "06/06/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Eight Week Summer", "exploreCriteriaIds": []}], "description": "This course introduces fundamental ideas of Systems Engineering and their application to the design and development of various types of engineered systems.&amp;nbsp; The systems engineering technical design process is emphasized, following the entire Vee-diagram process from initial problem definition and defining of system requirements, thru systems design &amp; architecture, to implementation planning, and &amp; testing and evaluation. The course also provides an applied introduction to a variety of areas that are commonly a part of Systems Engineering including creating effective project teams, customer needs evaluation, mathematical tools for system analysis, control &amp; optimization, risk analysis and mitigation, decision making strategies, project organization &amp; management, and the system life cycle. The course requires students to combine their work in this course with an outside-of-course MEng project.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Systems Engineering distance learning students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-09-01T07:41:12-0400", "catalogDttm": "2022-08-09T08:17:01-0400"}}