ilityDescrshort": "GSH283", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/15/2019", "endDt": "08/02/2019", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "NES", "catalogNbr": "2619", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This course examines the history and politics of the Middle East and its central place in world affairs from the turn of the twentieth century down to the present. Beginning with the end of the Ottoman Empire and European colonization and domination of the entire region following WWI, we will study the emergence of Arab, Turkish, Persian nationalisms and Zionism, social and religious reform, the discovery of oil and its strategic importance in world political economy, the role of the region in the Cold War between the US and the Soviet Union, the conflict between Israel, the Palestinians and the Arab states, the political use of Islam and 9/11/01 and its aftermath, the Arab uprisings of the last few years and the civil wars that followed, and the American sponsored nuclear agreement with Iran. Assigned readings and film viewing will be supplemented with translated primary sources for use in class and section meeting discussions.", "catalogBreadth": "(GB)", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 359630, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3071", "titleShort": "Enduring Global & Amer Issues", "titleLong": "Enduring Global and American Issues", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1151, "meetings": [{"classMtgNbr": 1, "timeStart": "06:30PM", "timeEnd": "09:15PM", "startDt": "06/03/2019", "endDt": "07/26/2019", "instructors": [{"instrAssignSeq": 2, "netid": "ds90", "firstName": "David", "middleName": "", "lastName": "Silbey"}], "pattern": "MW", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Washington, DC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=659"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "DC", "locationDescr": "Washington, DC", "startDt": "06/03/2019", "endDt": "07/26/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3071", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "The US and the global community face a number of complex, interconnected and enduring issues that pose challenges for our political and policy governance institutions and society at large.\u00a0 Exploring how the US and the world conceive of the challenges and take action on them is fundamental to understanding them.\u00a0 This course investigates such issues, especially ones that fit into the critically important areas of sustainability, social justice, technology, public health and globalization, security and conflict, among others. Students will engage with these areas and issues and the challenges they pose, using multiple frameworks and approaches, through weekly class discussions and lectures.\"", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 351417, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3141", "titleShort": "Prisons", "titleLong": "Prisons", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1154, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/29/2019", "endDt": "06/21/2019", "instructors": [{"instrAssignSeq": 3, "netid": "mfk2", "firstName": "Mary", "middleName": "Fainsod", "lastName": "Katzenstein"}], "pattern": "", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1883"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/29/2019", "endDt": "06/21/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3141", "type": "C"}], "sessionCode": "3WK", "sessionBeginDt": "05/29/2019", "sessionEndDt": "06/21/2019", "sessionLong": "Three Week Summer", "exploreCriteriaIds": null}], "description": "The United States stands alone among Western, industrialized countries with its persistent, high rates of incarceration, long sentences, and continued use of the death penalty. This \"American exceptionalism\" -- the turn to mass incarceration -- has been fostered by the use of sharply-delineated categories that define vast numbers of people as outlaws and others as law-abiding. These categories that are based on ideas of personal responsibility and\u00a0assumptions about race are modified somewhat by a liberal commitment to human rights.\u00a0\u00a0 Our purpose in this course is to understand how such ideas have taken root and to locate the consequences of these ideas for policy and practice.\u00a0", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 359631, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3150", "titleShort": "The Amer Legal System", "titleLong": "The American Legal System", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1157, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "06/03/2019", "endDt": "07/12/2019", "instructors": [{"instrAssignSeq": 2, "netid": "ces78", "firstName": "Charles", "middleName": "Evan", "lastName": "Stewart"}], "pattern": "MTWRF", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1747"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "CENYC", "locationDescr": "Continuing Ed in NYC", "startDt": "06/03/2019", "endDt": "07/12/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This course offers a comprehensive introduction to the American legal system, its roots in natural and common law, the purposes/values it serves (e.g., resolution of private grievances; punishment of offenses against the polity and individuals; preservation, development, and limitation of individual and group rights; and facilitation of commerce and private agreements), and the roles of the judiciary, legislature, and private parties. The course is taught using the Socratic method employed at most US law schools and introduces students to fundamental concepts and techniques used by attorneys and courts in analyzing cases, interpreting statutes, and determining disputes. As in law school, students are expected to read assigned materials before each class meeting and to participate actively in class discussions. For additional information, see the Summer Session website.\n\u00a0", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 351429, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3323", "titleShort": "Modern European Politics", "titleLong": "Modern European Politics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups"