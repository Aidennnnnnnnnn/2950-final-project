{"status": "success", "data": {"classes": [{"strm": 2846, "crseId": 358610, "crseOfferNbr": 1, "subject": "MAE", "catalogNbr": "2030", "titleShort": "Dynamics", "titleLong": "Dynamics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1503, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "06/20/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 4, "netid": "jc62", "firstName": "John Richard", "middleName": "", "lastName": "Callister"}], "pattern": "MTWRF", "facilityDescr": "Upson Hall 146", "bldgDescr": "Upson Hall", "facilityDescrshort": "UPS146", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2913"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/28/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/20/2023", "sessionEndDt": "08/01/2023", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Newtonian dynamics of a particle, systems of particles, rigid bodies, simple mechanisms and simple harmonic oscillators. Impulse, momentum, angular momentum, work and energy. Two-dimensional (planar) kinematics including motion relative to a moving reference frame. Three dimensional rigid-body dynamics are introduced at the instructor's option. Setting up the differential equations of motion and solving them both analytically and numerically with MATLAB. In-lecture laboratory demonstrations illustrate basic principles.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ENGRD 2020, MATH 2930, familiarity with MATLAB, or permission of instructor. Corequisite:  MATH 2940.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to draw free-body diagrams and vectors for mechanics.", "Students will be able to describe particle motion in 1-D, 2-D and 3-D employing Cartesian, polar, and path coordinates, and rotating coordinate systems.", "Students will be able to apply Newton/Euler laws, momentum and work-energy principles to the motion of particles and rigid bodies to find equations of motion and conserved quantities.", "Students will be able to recognize simple harmonic motions for 1-degree-of-freedom mechanical systems.", "Students will be able to solve equations of motion numerically, and analytically in simple cases, and graphically show the resulting motion(s).", "Students will be able to understand measurement of displacement, velocity and acceleration - and use such data to characterize the kinematics of simple mechanisms and 1-degree-of-freedom mechanical systems."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 358617, "crseOfferNbr": 2, "subject": "MAE", "catalogNbr": "2210", "titleShort": "Thermodynamics", "titleLong": "Thermodynamics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1508, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "12:45PM", "startDt": "06/20/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 3, "netid": "jc62", "firstName": "John Richard", "middleName": "", "lastName": "Callister"}], "pattern": "MTWRF", "facilityDescr": "Upson Hall 146", "bldgDescr": "Upson Hall", "facilityDescrshort": "UPS146", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1172"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/28/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ENGRD", "catalogNbr": "2210", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/20/2023", "sessionEndDt": "08/01/2023", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Presents the definitions, concepts, and laws of thermodynamics. Topics include the first and second laws, thermodynamic property relationships, and applications to vapor and gas power systems, refrigeration, and heat pump systems. Examples and problems are related to contemporary aspects of energy and power generation and to broader environmental issues.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-SBY)", "catalogWhenOffered": "Fall, Summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: MATH 1920\u00a0and PHYS 1112, or permission of instructor.\u00a0", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Students will be able to choose an appropriate system and identify interactions between system and surroundings.", "Students will be able to obtain values of thermodynamic properties for a pure substance in a given state, using tables, relations for incompressible substances, and relations for gases.", "Students will be able to apply energy and entropy balances in the control mass (closed system) and control volume formulations to the analysis of devices and cycles."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 363600, "crseOfferNbr": 1, "subject": "MAE", "catalogNbr": "4998", "titleShort": "International Research Intern", "titleLong": "International Research Internship", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "RSC", "ssrComponentLong": "Research", "section": "701", "classNbr": 2054, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "07/03/2023", "endDt": "08/14/2023", "instructors": [], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/03/2023", "endDt": "08/14/2023", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "RE", "instrMo