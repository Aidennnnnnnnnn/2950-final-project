ttr": "0009", "crseAttrValue": "PCONLINE", "descr": "Precollege Online", "descrformal": "Precollege Studies Online Program", "attrDescr": "School of Continuing Education", "attrDescrShort": "SCE"}, {"crseAttr": "0012", "crseAttrValue": "ALC-AS", "descr": "AS-Arts, Literat, and Culture", "descrformal": "AS-Arts, Literature, and Culture", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "LA-AG", "descr": "AG-Literature & the Arts", "descrformal": "AG-Literature and the Arts", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ARKEO", "catalogNbr": "2700", "type": "B"}, {"subject": "CLASS", "catalogNbr": "2700", "type": "B"}], "sessionCode": "WS", "sessionBeginDt": "01/04/2027", "sessionEndDt": "01/23/2027", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "The art of Ancient Greece and Rome has a complex legacy within western culture that is inseparable from ideas about power, beauty, identity, and knowledge. As such, 'Classical' art has been appropriated for all kinds of ends, many of them deeply problematic. But what did ancient statues, paintings, vessels, or buildings mean for the cultures that originally created, viewed, and lived alongside them? How were they embedded within political and social structures, religious practices, and public or domestic spaces? What can they tell us about practices of representation and story-telling? How might they help us access ancient attitudes to gender, ethnicity, or social status? And why is any of this still relevant today? This course on Greek and Roman art and archaeology will address all these questions. Covering the time span from the Bronze Age (3rd millennium BCE) to the late Roman Empire (4th century CE), we will focus on one object or monument each lecture, considering how it can be considered exemplary for its time. Where possible, we will engage with artefacts in our collections at Cornell, including the plaster-casts, as we develop skills in viewing, analyzing, and contextualizing material evidence. (ARKEO-RMNE)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026SP, 2026WI, 2025SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2944, "crseId": 372863, "crseOfferNbr": 3, "subject": "ARTH", "catalogNbr": "3590", "titleShort": "Heritage, History, Identity", "titleLong": "Heritage, History, and Identity in Cambodia", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "SEAREA", "descr": "Southeast Asia Studies Area", "descrformal": "Southeast Asia Studies Area", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cul