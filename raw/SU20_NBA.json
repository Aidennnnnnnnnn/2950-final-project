], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2526"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/13/2020", "endDt": "07/31/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [], "sessionCode": "3W3", "sessionBeginDt": "07/13/2020", "sessionEndDt": "07/31/2020", "sessionLong": "Three Week - Three", "exploreCriteriaIds": null}], "description": "In today's increasingly globalized and interconnected world, international transactions as part of business are the norm. Even purely domestic firms have to deal with international issues, be it in the form of imported supplies or foreign competitors. In addition, more and more companies are going abroad to pursue their major business objectives. How can they take advantage of the global marketplace and create economic value through their multimarket activities? This course has three integrated objectives: first, to give you a basic grounding in global business, so that you can become capable of understanding and analyzing events and trends in the global business environment and their impact on managerial decision making; second, to help you understand the analytical frameworks on strategy formulation and implementation in an international context; and third, through a series of concrete case discussions and a local product internationalization project, the course aims at developing your practical skills in applying the tools of global strategic analysis in concrete business situations. Its ultimate goal is to help you become better prepared to serve in and lead business organizations in today's globalized world.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "Johnson School students will not receive credit for winter session courses offered through Continuing Education.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 350671, "crseOfferNbr": 1, "subject": "NBA", "catalogNbr": "6650", "titleShort": "Strat Mgmt of Tech & Innov", "titleLong": "The Strategic Management of Technology and Innovation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1387, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/22/2020", "endDt": "07/10/2020", "instructors": [{"instrAssignSeq": 1, "netid": "xs255", "firstName": "Xirong", "middleName": "", "lastName": "Shen"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3341"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/22/2020", "endDt": "07/10/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPI", "gradingBasisShort": "Opt NoAud", "gradingBasisLong": "Letter or S/U grades (no audit)", "simpleCombinations": [{"subject": "NBA", "catalogNbr": "2650", "type": "W"}], "sessionCode": "3W2", "sessionBeginDt": "06/22/2020", "sessionEndDt": "07/10/2020", "sessionLong": "Three Week - Second", "exploreCriteriaIds": null}], "description": "This is an introductory management course covering the strategic management of technology and innovation in established firms as well as startup organizations. This course is designed for students who may someday work in, consult for, and/or create firms whose primary product is fundamentally related to technology or innovation. The course typically includes both M.B.A. students and graduate students in science. It starts by examining how industries are transformed by new technologies and how these patterns of industrial change generate both opportunity and high rates of firm failure. We will then explore the questions: Why do some technology leaders fail? and How do technology innovators successfully take on and replace incumbent firms? This leads to an examination of internal management issues, focusing on the design of innovative organizations: designing reward systems, managing growth, overcoming resistance to change, and using organizational culture to promote innovation.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2021-02-11T19:14:03-0500", "catalogDttm": "2020-06-28T19:15:08-0400"}}