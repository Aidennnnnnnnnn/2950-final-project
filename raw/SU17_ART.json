05/31/2017", "sessionEndDt": "08/08/2017", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Art as Experience is an introductory course that expands a student's understanding of the ideas and practices of art today. Studio projects will introduce a broad range of mediums from drawing and collage to digital photography and video installation. Students will explore and respond to resources at Cornell University and the course will be supplemented with readings, critiques and field trips.\u00a0 The course will culminate in an exhibition where students will be responsible for the organization and installation of self-directed art work.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer (three-week session).", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Counts as free elective credit for B.F.A. students.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 368019, "crseOfferNbr": 1, "subject": "ART", "catalogNbr": "1102", "titleShort": "Art as Experience II", "titleLong": "Art as Experience II: TransMedia", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 1409, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "07/17/2017", "endDt": "08/04/2017", "instructors": [{"instrAssignSeq": 6, "netid": "meg364", "firstName": "Mark", "middleName": "E", "lastName": "Grimm"}], "pattern": "MTWRF", "facilityDescr": "Sibley Hall 305", "bldgDescr": "Sibley Hall", "facilityDescrshort": "SBL305", "meetingTopicDescription": ""}, {"clas