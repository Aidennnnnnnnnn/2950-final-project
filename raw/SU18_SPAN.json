iption": "This advanced-intermediate course is designed to prepare students for study abroad, entry into the major, and advanced-level courses. Students study stylistics, analyze and discuss texts, view films, and acquire advanced reading strategies. Continued emphasis is on writing and editing academic essays with peer and instructor feedback. Classes are in Spanish, and the language is actively used in oral presentations and communicative, creative, and critical-thinking activities. Students review grammar structures on their own, although the instructor may clarify as needed. The course is a pre-requisite for the major and may be taken concurrently with SPAN 2140, SPAN 2150, or SPAN 2170.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "Satisfies Option 1.", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: SPAN 2070, SPAN 2090, or CASE Q+.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 369612, "crseOfferNbr": 1, "subject": "SPAN", "catalogNbr": "2097", "titleShort": "Monologue: Being in the World", "titleLong": "Monologue: Being in the World", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1667, "meetings": [{"classMtgNbr": 1, "timeStart": "10:10AM", "timeEnd": "11:00AM", "startDt": "05/28/2018", "endDt": "07/06/2018", "instructors": [{"instrAssignSeq": 3, "netid": "gla23", "firstName": "Gerard", "middleName": "Laurence", "lastName": "Aching"}, {"instrAssignSeq": 2, "netid": "cbl6", "firstName": "Cecelia", "middleName": "", "lastName": "Lawless"}], "pattern": 