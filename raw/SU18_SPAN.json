panish and the language is actively used in communicative and creative activities. Students engage in linguistic and literary analysis of texts to acquire new vocabulary, complete analytical exercises, and develop reading strategies. Students continue developing writing skills through composition, give oral presentations, and review grammatical structures independently with some clarification by the instructor as needed. After this course, students may take SPAN 2000, SPAN 2070, or SPAN 2090.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, spring.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: SPAN 1120, SPAN 1220, or LPS 45-55.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 359167, "crseOfferNbr": 1, "subject": "SPAN", "catalogNbr": "2090", "titleShort": "Span Intermed Comp&Conv I", "titleLong": "Intermediate Spanish I (Composition and Conversation)", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1364, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "10:00AM", "startDt": "05/28/2018", "endDt": "07/06/2018", "instructors": [{"instrAssignSeq": 2, "netid": "cbl6", "firstName": "Cecelia", "middleName": "", "lastName": "Lawless"}], "pattern": "MTWRF", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Madrid, Spain. This Summer Session class is offered by the School of  Continuing Education and Summer Sessions. For details visit http://www.sce.