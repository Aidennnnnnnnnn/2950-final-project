veys the history of the West from remote antiquity to the 16th century. We will consider developments in technology, economy, politics, religious institutions and faiths, cultural media and social ideals. Together, these themes add up to civilization in the west. We will acquaint ourselves with these dimensions of the past while seeking to acquire the basic skills professional historians use to learn about this past.", "catalogBreadth": "(HB)", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 367904, "crseOfferNbr": 1, "subject": "HIST", "catalogNbr": "1591", "titleShort": "Global Approach Modern Chinese", "titleLong": "A Global Approach to Modern Chinese History", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1467, "meetings": [{"classMtgNbr": 1, "timeStart": "11:30AM", "timeEnd": "12:45PM", "startDt": "06/24/2019", "endDt": "08/02/2019", "instructors": [{"instrAssignSeq": 3, "netid": "js624", "firstName": "Jia", "middleName": "", "lastName": "Sheng"}], "pattern": "MTWRF", "facilityDescr": "McGraw Hall 215", "bldgDescr": "McGraw Hall", "facilityDescrshort": "MCG215", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3075"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2019", "endDt": "08/02/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2019", "sessionEndDt": "08/02/2019", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "This course surveys modern Chinese history from a global perspective starting from the 19th century to the dawn of the 21st century. It is a lecture and discussion course that aims to help the students develop a better understanding of the major events that have, for better or worse, shaped China and made it what it is today. The key themes of the course include: Chinese response to the demands of Western powers, foreign images of China, the Opium Wars, the rise of a new order, the fragmentation and reform of the Qing Empire, the rise and fall of the nationalist government, the rise of communism and the People's Republic, the challenge of Deng's reforms and China's impact on the world.", "catalogBreadth": "(GB)", "catalogDistr": "(HA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(HNU)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 370206, "crseOfferNb