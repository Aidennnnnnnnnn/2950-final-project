iology.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": ["Provide examples of the kinds of questions evolutionary biologists ask, and the types of tools and evidence they use to answer them.", "Recognize and correct common misunderstandings about evolution.", "Differentiate between the four main mechanisms of evolution (mutation, natural selection, migration, genetic drift).", "Communicate about evolutionary principles to classmates and the general public.", "Describe examples of evolution occurring in the modern day.", "Articulate specific applications of evolutionary biology in medicine and agriculture."], "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026SP, 2025SU, 2024SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 359787, "crseOfferNbr": 1, "subject": "STS", "catalogNbr": "1451", "titleShort": "Body, Mind, and Health", "titleLong": "Body, Mind, and Health: Historical Perspectives for Future Professionals", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1442, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "07/13/2026", "endDt": "07/31/2026", "instructors": [{"instrAssignSeq": 1, "netid": "jll338", "firstName": "Jennifer", "middleName": "L.", "lastName": "Lieberman"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the Sch