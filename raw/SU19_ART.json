t. Topics addressed during the course will include digital photography, digital video, audio and video editing, stop-animation, slow-motion video, macro photography, programing for audio/ visual interaction, and physical computing.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 369453, "crseOfferNbr": 1, "subject": "ART", "catalogNbr": "1103", "titleShort": "Art as Experience: Sculpture", "titleLong": "Art as Experience: Sculpture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 1388, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "07/15/2019", "endDt": "08/02/2019", "instructors": [{"instrAssignSeq": 1, "netid": "cjo37", "firstName": "Christopher", "middleName": "J.", "lastName": "Oliver"}], "pattern": "MTWRF", "facilityDescr": "Olive Tjaden Hall 205", "bldgDescr": "Olive Tjaden Hall", "facilityDescrshort": "TJN205", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "01:30PM", "timeEnd": "04:00PM", "startDt": "07/15/2019", "endDt": "08/02/2019", "instructors": [{"instrAssignSeq": 1, "netid": "cjo37", "firstName": "Christopher", "middleName": "J.", "lastName": "Oliver"}], "pattern": "MTWRF", "facilityDescr": "Olive Tjaden Hall 205", "bldgDescr": "Olive Tjaden Hall", "facilityDescrshort": "TJN205", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3225"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/15/2019", "endDt": "08/02/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["STU"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Sculpture is distinguishable from other visual arts through its inherent use of space and reliance on an enormous range of materials. It is in our space, it makes us move in a certain way and it makes us want to move in a certain way. Because sculpture is physical like us, we respond to it on a visceral level. Sculpture can also be made out of literally anything, and each \"anything\" already comes with its own meanings and associations. All of these are givens, even before we decide what our work is about. This is what makes sculpture so powerful and exciting, and also so challenging. This course begins by exploring these givens though a number of very specific assignments and discussions. After a level of class-wide proficiency has been attained each student will develop their own line of inquiry and develop highly individualized projects.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summe