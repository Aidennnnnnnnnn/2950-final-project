useums, archaeological zones, and the residents and visitors who occupy it. A variety of materials are used including pencil, ink, charcoal, pastel and collage. With the exception of one or two in-studio sessions, all work will be done onsite in Rome. Course meets four weeks, five times per week.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Counts as free elective for B.F.A. students.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 354267, "crseOfferNbr": 1, "subject": "ART", "catalogNbr": "2201", "titleShort": "Painting: Intro to Painting", "titleLong": "Painting: Introduction to Painting", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 1400, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "11:00AM", "startDt": "06/24/2019", "endDt": "08/02/2019", "instructors": [{"instrAssignSeq": 4, "netid": "gf264", "firstName": "Gail", "middleName": "", "lastName": "Fitzgerald"}], "pattern": "MTWRF", "facilityDescr": "Olive Tjaden Hall 424", "bldgDescr": "Olive Tjaden Hall", "facilityDescrshort": "TJN424", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=342"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2019", "endDt": "08/02/2019", "addConse