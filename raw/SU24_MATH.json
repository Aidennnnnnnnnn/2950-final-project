 (Main Campus)", "startDt": "06/24/2024", "endDt": "08/02/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2024", "sessionEndDt": "08/06/2024", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Topics include functions and graphs, limits and continuity, differentiation and integration of algebraic, trigonometric, inverse trig, logarithmic, and exponential functions; applications of differentiation, including graphing, max-min problems, tangent line approximation, implicit differentiation, and applications to the sciences; the mean value theorem; and antiderivatives, definite and indefinite integrals, the fundamental theorem of calculus, and the area under a curve.", "catalogBreadth": "", "catalogDistr": "(MQR-AS, SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will not receive credit for both MATH 1106\u00a0and MATH 1110.", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "Prerequisite: three years of high school mathematics (including trigonometry and logarithms) or a precalculus course (e.g., MATH 1101). MATH 1110 can serve as a one-semester introduction to calculus or as part of a two-semester sequence in which it is followed by MATH 1120. For guidance in selecting an appropriate course, please consult First Steps in Math.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 352255, "crseOfferNbr": 1, "subject": "MATH", "catalogNbr": "1910", "titleShort": "Calculus for Engineers", "titleLong": "Calculus for Engineers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1109, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "10:15AM", "startDt": "06/24/2024", "endDt": "08/02/2024", "instructors": [{"instrAssignSeq": 6, "netid": "mrh286", "firstName": "Matthew", "middleName": "R.", "lastName": "Haulmark"}], "pattern": "MTWRF", "facilityDescr": "Phillips Hall 407", "bldgDescr": "Phillips Hall", "facilityDescrshort": "PHL407", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2024", "endDt": "08/02/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2024", "sessionEndDt": "08/06/2024", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Essentially a second course in calculus. Topics include techniques of integration, finding areas and volumes by integration, exponential growth, partial fractions, infinite sequences and series, tests of convergence, and power series.", "catalogBreadth": "", "catalogDistr": "(MQR-AS, SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will not receive credit for both MATH 1120\u00a0and MATH 1910.", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "Prerequisite: three years high school mathematics, including trigonometry and logarithms, and at least one course in differential and integral calculus, or equivalent AP credit. For guidance in selecting an appropriate course, please consult First Steps in Math.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 352257, "crseOfferNbr": 1, "subject": "MATH", "catalogNbr": "1920", "titleShort": "Multivariable Calculus Engrs", "titleLong": "Multivariable Calculus for Engineers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1110, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "10:15AM", "startDt": "06/24/2024", "endDt": "08/02/2024", "instructors": [{"instrAssignSeq": 6, "netid": "ll87", "firstName": "Luigi", "middleName": "", "lastName": "La Ragione"}], "pattern": "MTWRF", "facilityDescr": "Phillips Hall 403", "bldgDescr": "Phillips Hall", "facilityDescrshort": "PHL403", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2024", "endDt": "08/02/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2024", "sessionEndDt": "08/06/2024", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Introduction to multivariable calculus. Topics include partial derivatives, double and triple integrals, line and surface integrals, vector fields, Green's theorem, Stokes' theorem, and the divergence theorem.", "catalogBreadth": "", "catalogDistr": "(MQR-AS, SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will receive credit for only one course in the following group: MATH 1920, MATH 2130, MATH 2220, MATH 2240.", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "For guidance in selecting an appropriate course, please consult First Steps in Math.", "catalogPrereqCoreq": "Prerequisite: MATH 1910\u00a0or equivalent AP credit.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 352295, "crseOfferNbr": 1, "subject": "MATH", "catalogNbr": "2930", "titleShort": "Differential Equations Engrs", "titleLong": "Differential Equations for Engineers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1111, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "10:15AM", "startDt": "06/24/2024", "endDt": "08/02/2024", "instructors": [{"instrAssignSeq": 6, "netid": "kp588", "firstName": "Kelly", "middleName": "", "lastName": "Pohland"}], "pattern": "MTWRF", "facilityDescr": "Phillips Hall 307", "bldgDescr": "Phillips Hall", "facilityDescrshort": "PHL307", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2024", "endDt": "08/02/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2024", "sessionEndDt": "08/06/2024", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Introduction to ordinary and partial differential equations. Topics include: first-order equations (separable, linear, homogeneous, exact); mathematical modeling (e.g., population growth, terminal velocity); qualitative methods (slope fields, phase plots, equilibria, and stability); numerical methods; second-order equations (method of undetermined coefficients, application to oscillations and resonance, boundary-value problems and eigenvalues); and Fourier series. A substantial part of this course involves partial differential equations, such as the heat equation, the wave equation, and Laplace's equation. (This part must be present in any outside course being considered for transfer credit to Cornell as a substitute for MATH 2930.)", "catalogBreadth": "", "catalogDistr": "(MQR-AS, SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "Taking MATH 2930 and MATH 2940\u00a0simultaneously is not recommended.", "catalogPrereqCoreq": "Prerequisite: MATH 1920.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 352307, "crseOfferNbr": 1, "subject": "MATH", "catalogNbr": "2940", "titleShort": "Linear Algebra for Engineers", "titleLong": "Linear Algebra for Engineers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1119, "meetings": [{"classMtgNbr": 1, "timeStart": "10:30AM", "timeEnd": "12:15PM", "startDt": "06/24/2024", "endDt": "08/02/2024", "instructors": [{"instrAssignSeq": 6, "netid": "ma735", "firstName": "Mahdi", "middleName": "", "lastName": "Asgari"}], "pattern": "MTWRF", "facilityDescr": "Malott Hall 207", "bldgDescr": "Malott Hall", "facilityDescrshort": "MLT207", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School