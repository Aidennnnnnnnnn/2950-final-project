 shape personality?\u00a0 Is personality an expression of our genetic make up and biology, the culmination of social influences, the interplay of both, or the result of random events?\u00a0 In this course, we will review the major theoretical paradigms of personality psychology, discuss contemporary research, theory, and methodology, and learn about key historical debates in the study of \"personality\".", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, winter, summer (three-week session).", "catalogComments": "Winter and summer classes taught via distance learning.", "catalogPrereqCoreq": "Prerequisite: introductory psychology or human development course is recommended.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2685, "crseId": 351675, "crseOfferNbr": 1, "subject": "PSYCH", "catalogNbr": "3800", "titleShort": "Social Cognition", "titleLong": "Social Cognition", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1042, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/02/2018", "endDt": "01/20/2018", "instructors": [{"instrAssignSeq": 5, "netid": "mjf44", "firstName": "Melissa", "middleName": "J.", "lastName": "Ferguson"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Winter Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ws/courses/courses.php?v=3056"}],