rk. Students learn how to communicate specialized information to different audiences (e.g., technical and nontechnical audiences, colleagues and clients, peers and supervisors, and in-house departments), work in teams, and address organizational and ethical issues including using AI tools, equity, inclusiveness, and accessibility. The course material is drawn from professional contexts.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: Engineering (EN) and Biological & Environmental Engineering (BEE) juniors and seniors; others by permission of instructor.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "two (2) First-Year Writing Seminars and major affiliation.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2026SU, 2026SP, 2025FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 375449, "crseOfferNbr": 1, "subject": "ENGRC", "catalogNbr": "3600", "titleShort": "Communicating Data", "titleLong": "Communicating Data for Engineers", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "CE-EN", "descr": "EN-Communications in Engineer", "descrformal": "EN-Communications in Engineering", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(CE-EN)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18367, "meetings": [{"classMtgNbr": 1,