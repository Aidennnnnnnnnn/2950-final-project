 "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/24/2026", "endDt": "12/19/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "As a technical contributor or expert, engineers are called on frequently to give presentations (proposals, technical updates, progress reporting, client pitches, engineering advancements/information, and more). However, many presenters have not had specific training about planning, preparing, honing, executing, documenting, and archiving their presentation work; this course addresses those skills. As well, issues of cross-cultural communication, institutional need, audience assessment, and personal presence will be covered. Students should expect to align their work and presentations in this class with a major project in their field. Students will give both individual and team talks.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: Engineering (EN) and Biological & Environmental Engineering (BEE) juniors and seniors; others by permission of instructor.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "two First-Year Writing Seminars and major affiliation.", "catalogCoreq": "", "catalog