Mode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 2.5, "unitsMaximum": 2.5, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "NCCY", "catalogNbr": "5090", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Among the critical tasks facing any senior manager are the creation, implementation, and evaluation of a business unit's strategy. This course seeks to provide the management student with the tools and frameworks essential to carrying out these tasks. Many of these tools and frameworks are based on recent advances in game theory, industrial organization, and organization theory, although the course also draws from the older business policy tradition. Students who successfully complete this course are able to analyze industries, identify areas of strategy advantage and disadvantage, and devise strategies that exploit advantages and remedy disadvantages.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer, Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Limited enrollment.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-09-03T19:14:21-0400", "catalogDttm": "2019-06-13T19:15:21-0400"}}