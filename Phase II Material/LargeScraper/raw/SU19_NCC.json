radingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "NCCY", "catalogNbr": "5050", "type": "W"}], "sessionCode": "1", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Succeeding in any business leadership role requires you to think critically, and make quality decisions, even in the face of challenges such as imperfect/incomplete information, changing and unforeseen circumstances, and human nature in all of its complexity and unpredictability. \u00a0Major content themes of this course focus on constructing a persuasive argument and deconstructing arguments made by others; recognizing and avoiding reasoning flaws and the forces that make us most susceptible to such flaws; approaching business problems systematically and thoroughly; and producing a problem solution that is (a) well-reasoned; (b) likely to be well-received by ultimate decision makers; and (c) able to be implemented successfully.\u00a0", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer, Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Limited enrollment.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 350794, "crseOfferNbr": 1, "subject": "NCC", "catalogNbr": "5060", "titleShort": "Managerial Finance", "titleLong": "Managerial Finance", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1571, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "tim