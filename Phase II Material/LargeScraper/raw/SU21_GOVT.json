rld. This course focuses on the similarities and differences between forms, causes, and effects of corruption in various environments. The course starts with a discussion of the definitions, causes, and effects of corruption across countries, and then turns to particular forms and contexts where corruption is observed: for example, developed and developing countries, conflict-ridden societies, and international investment. We will also discuss some of the potential solutions to corruption and their costs and benefits for political and civil society.", "catalogBreadth": "", "catalogDistr": "(SBA-AS, GLC-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 359349, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3827", "titleShort": "China and the World", "titleLong": "China and the World", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1213, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "06/01/2021", "endDt": "06/17/2021", "instructors": [{"instrAssignSeq": 3, "netid": "arc26", "firstName": "Allen", "middleName": "R.", "lastName": "Carlson"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3332"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/01/2021", "endDt": "06/17/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASIAN", "catalogNbr": "3327", "type": "C"}, {"subject": "CAPS", "catalogNbr": "3827", "type": "C"}], "sessionCode": "3W1", "sessionBeginDt": "06/01/2021", "sessionEndDt": "06/17/2021", "sessionLong": "Three Week - First", "exploreCriteriaIds": null}], "description": "Study of the dramatic rise of China through reviewing major developments in contemporary Chinese foreign policy since the establishment of the People's Republic of China (PRC), and concentrating more specifically on major developments in Chinese foreign policy during the 1980s and 1990s. Such a wide-ranging survey of Chinese foreign policy involves not only a consideration of the evolution of China's relations with its major bilateral partners but also an investigation of how China has defined its broader relationship with the international system. In addition, students are asked to consider which causal factors have been of primary importance in motivating Chinese behavior.", "catalogBreadth": "(GB)", "catalogDistr": "(CA-AS, GLC-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(IR)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 368788, "crseOfferNbr": 2, "subject": "GOVT", "catalogNbr": "3887", "titleShort": "Int'l Human Rights Theo & Prac", "titleLong": "International Human Rights in Theory and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1152, "meetings": [{"classMtgNbr": 1, "timeStart": "11:00AM", "timeEnd": "12:00PM", "startDt": "06/21/2021", "endDt": "07/09/2021", "instructors": [{"instrAssignSeq": 1, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3227"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/21/2021", "endDt": "07/09/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LAW", "catalogNbr": "3887", "type": "C"}], "sessionCode": "3W2", "sessionBeginDt": "06/21/2021", "sessionEndDt": "07/09/2021", "sessionLong": "Three Week - Second", "exploreCriteriaIds": null}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 1082, "meetings": [{"classMtgNbr": 1, "timeStart": "07:00PM", "timeEnd": "08:15PM", "startDt": "07/12/2021", "endDt": "07/30/2021", "instructors": [{"instrAssignSeq": 3, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3227"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/12/2021", "endDt": "07/30/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LAW", "catalogNbr": "3887", "type": "C"}], "sessionCode": "3W3", "sessionBeginDt": "07/12/2021", "sessionEndDt": "07/30/2021", "sessionLong": "Three Week - Three", "exploreCriteriaIds": null}], "description": "This course will introduce students to the law, theory, and practice of international human rights. Students will think critically about the effectiveness of the\u00a0international human rights system by examining its successes, failures, and dilemmas in preventing and responding to human rights abuse. Topics covered will include the origins and foundations of international human rights; the role of international, regional,\u00a0and domestic institutions and actors in enforcing human rights; critiques of the human rights movement; and the relationship of the\u00a0United States to the international system for the protection of human rights. The course will also explore issues such as the\u00a0death penalty, women's human rights, migration, climate change, global poverty, racism and xenophobia, and responses to mass atrocities. During in-class activities, students will have the opportunity to step into the shoes of a human rights advocate and work\u00a0with their classmates to address simulated human rights problems.", "catalogBreadth": "(GB)", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(IR)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2021-09-09T19:14:03-0400", "catalogDttm": "2021-09-09T19:15:17-0400"}}