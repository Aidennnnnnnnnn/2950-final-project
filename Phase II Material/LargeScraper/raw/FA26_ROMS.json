": 2937, "crseId": 373249, "crseOfferNbr": 2, "subject": "ROMS", "catalogNbr": "6190", "titleShort": "The Uncanny", "titleLong": "The Uncanny", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 18773, "meetings": [{"classMtgNbr": 1, "timeStart": "02:00PM", "timeEnd": "04:30PM", "startDt": "08/24/2026", "endDt": "12/07/2026", "instructors": [{"instrAssignSeq": 1, "netid": "pmk73", "firstName": "Patricia", "middleName": "M.", "lastName": "Keller"}], "pattern": "R", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/24/2026", "endDt": "12/19/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "COML", "catalogNbr": "4196", "type": "B"}, {"subject": "COML", "catalogNbr": "6196", "type": "B"}, {"subject": "ROMS", "catalogNbr": "4196", "type": "B"}, {"subject": "SPAN", "catalogNbr": "4196", "type": "B"}, {"subject": "SPAN", "catalogNbr": "6190", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "In the field of aesthetics, the uncanny refers to an affective state, most commonly the sensation of encountering something-an object, a place, a situation-as both familiar and strange at the same time. Such experience of the strange-familiar (unheimlich) produces a disquieting sense of uncertainty, uneasiness, or doubt and may even spark extreme feelings of alienation, anxiety, dread, horror, and repulsion. This seminar explores the philosophical origins and conceptual terrain of the uncanny in relation to 20th and 21st century artistic, literary, architectural and cinematic production. If the uncanny traditionally signals a blurring of categories (familiar/unfamiliar, truth/fiction, reality/imagination) resulting in a fundamental distrust of observed reality, then what might its contemporary iterations reveal about our age of pervasive suspicion?", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2023FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-10-15T19:07:30-0400"}}