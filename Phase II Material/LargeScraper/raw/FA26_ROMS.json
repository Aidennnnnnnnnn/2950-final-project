, "catalogNbr": "3524", "type": "B"}, {"subject": "COML", "catalogNbr": "3524", "type": "B"}, {"subject": "FREN", "catalogNbr": "3526", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "If humanistic research consists of finding consensus positions, articulating simple expressions, summarizing texts, standardizing identities, or doing passable translations, then this it: we arrived at the place where artificial intelligence is able to accomplish these missions to a convincing degree. However, we erred if we ever thought such tasks would constitute the humanities. Combining theory and practice, this interdisciplinary class aims to show what AI can generate, and capture\u2026 and what the humanities can create, and think. A critique of AI is essential, but it needs to be both scientifically sound and scholarly robust. Our course will look at key issues about language, cognition, textuality, or creativity, while taking advantage of ongoing research and editorial projects hosted by the Humanities Lab.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 375390, "crseOfferNbr": 2, "subject": "ROMS", "catalogNbr": "4196", "titleShort": "The Uncanny", "titleLong"