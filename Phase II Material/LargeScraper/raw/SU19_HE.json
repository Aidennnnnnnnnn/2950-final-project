 session).", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: prefreshman Summer Program students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 359722, "crseOfferNbr": 1, "subject": "HE", "catalogNbr": "4080", "titleShort": "Health Care Culture and Career", "titleLong": "Practicing Medicine Health Care Culture and Careers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1466, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "05:00PM", "startDt": "06/03/2019", "endDt": "07/26/2019", "instructors": [{"instrAssignSeq": 1, "netid": "sb43", "firstName": "Sam", "middleName": "", "lastName": "Beck"}], "pattern": "MTWRF", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2324"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "CENYC", "locationDescr": "Continuing Ed in NYC", "startDt": "06/03/2019", "endDt": "07/26/2019", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Students learn through a cycle of action, experience, and reflection and as ethnographic participant observers. Over the course of the summer, students learn how to implement experience-based learning techniques and perspectives to enhance their competencies as initiates of professional medical practice. Students spend four days each week shadowing physicians in assigned NYC private or public hospitals. One day each week three different seminars engage students in exploring the world of medicine. Weill Cornell medical practitioners discuss different specialties, professional practice, opportunities and challenges in medical careers, and the culture of medicine. This is followed by two student led seminars that explore a variety of topics, experiential learning and ethnographic methods in medicine. Students use their experiences as a source for writing journals and oral reflections to improve how to engage medical learning.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-SBY, CU-UGR)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2019-09-03T19:14:21-0400", "catalogDttm": "2019-06-13T19:15:21-0400"}}