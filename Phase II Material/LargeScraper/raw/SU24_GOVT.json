Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2024", "endDt": "07/12/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W2", "sessionBeginDt": "06/24/2024", "sessionEndDt": "07/12/2024", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1088, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "07/15/2024", "endDt": "08/02/2024", "instructors": [{"instrAssignSeq": 4, "netid": "ua42", "firstName": "Uriel", "middleName": "", "lastName": "Abulof"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/15/2024", "endDt": "08/02/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W3", "sessionBeginDt": "07/15/2024", "sessionEndDt": "08/02/2024", "sessionLong": "Three Week - Three", "exploreCriteriaIds": []}], "description": "\"What's true of all the evils in the world is true of plague as well. It helps men to rise above themselves,\" wrote Albert Camus in The Plague. It is not just the current pandemic: climate change, warlike politics, polarization, tribalism, raging anxieties, AI advancement \u2013 these are just some of the many existential troubles and challenges we all, and our very \"human nature,\" now face. This is our time to realize our humanity: find out what sets us apart as humans, and live up to it.\nThis course invites you to an existential odyssey into the human condition and politics. Are we truly different from animals and machines? What does it mean to \"be yourself\"? What's the difference between freedom and liberty? Should we pursue happiness? Why do we yield to fear and anxiety? Is the search for meaning meaningless? Do we live in a post-truth era? What are the roles of morality in our society and politics? Why is God dead, but religion alive? Can we defeat alienation? Is love all we need? How much can, and should, we hope for? In this course, utilizing\u00a0the award-winning edX HOPE (Human Odyssey to Political Existentialism; see https://tinyurl.com/hope44), we will address these questions, and then some more. We shall examine a dozen themes, entwining each with critical reflections, both personal and political, amidst the current crisis: Human/nature, identity &amp; authenticity, freedom, reflection, happiness, death &amp; dread, meaning, morality, truth &amp; trust, God &amp; religion, alienation &amp; love, and finally \u2013 hope.", "catalogBreadth": "", "catalogDistr": "(ETM-AS, KCM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(AM, CP, IR, PT)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 373818, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3796", "titleShort": "Freedom", "titleLong": "Freedom", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1086, "meetings": [{"classMtgNbr": 1, "timeStart": "12:00PM", "timeEnd": "03:00PM", "startDt": "06/03/2024", "endDt": "06/21/2024", "instructors": [{"instrAssignSeq": 4, "netid": "ecs248", "firstName": "Ella", "middleName": "Carpenter", "lastName": "Street"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/03/2024", "endDt": "06/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "3W1", "sessionBeginDt": "06/03/2024", "sessionEndDt": "06/21/2024", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "What does it mean to be free? What does freedom require? How do capitalism and neoliberalism shape the way we think about freedom, and the possibilities for freedom?\u00a0 These are some of the questions we will consider together over the course of this class. We will begin with early modern and influential accounts of government by consent and the relationship between the individual and the state (Hobbes, Locke); we will then reflect upon the origins of inequality and the possibility of self-rule in modern society (Rousseau) and consider whether and how capitalism and neoliberalism threaten or support freedom (Marx, Brown, Tolentino). In the final week of the course, we turn to the American case, and examine the competing visions of freedom that inform the American imaginary. We will study thinkers who attend to the legacies of slavery and to the contradictions at the heart of the American project and interrogate the role of prophetic language and the idea of redemption in American political thought and practice (MLK, Morrison, Baldwin).", "catalogBreadth": "", "catalogDistr": "(HA-AS, HST-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 368788, "crseOfferNbr": 2, "subject": "GOVT", "catalogNbr": "3887", "titleShort": "Int'l Human Rights Theo & Prac", "titleLong": "International Human Rights in Theory and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1007, "meetings": [{"classMtgNbr": 1, "timeStart": "10:15AM", "timeEnd": "11:15AM", "startDt": "06/24/2024", "endDt": "07/12/2024", "instructors": [{"instrAssignSeq": 1, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:30AM", "timeEnd": "12:30PM", "startDt": "06/24/2024", "endDt": "07/12/2024", "instructors": [{"instrAssignSeq": 1, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2024", "endDt": "07/12/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LAW", "catalogNbr": "3887", "type": "C"}], "sessionCode": "3W2", "sessionBeginDt": "06/24/2024", "sessionEndDt": "07/12/2024", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}], "description": "This course will introduce students to the law, theory, and practice of international human rights. Students will think critically about the effectiveness of the\u00a0international human rights system by examining its successes, failures, and dilemmas in preventing and responding to human rights abuse. Topics covered will include the origins and foundations of international human rights; the role of international, regional,\u00a0and domestic institutions and actors in enforcing human rights; critiques of the human rights movement; and the relationship of the\u00a0United States to the international system for the protection of human rights. The course will also explore issues such as the\u00a0death penalty, women's human rights, migration, climate change, global poverty, racism and xenophobia, and responses to mass atrocities. During in-class activities, students will have the opportunity to step into the shoes of a human rights advocate and work\u00a0with their classmates to address simulated human rights problems.", "catalogBreadth": "(GB)", "catalogDistr": "(GLC-AS, SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(IR)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2024-12-09T19:39:29-0500", "catalogDttm": "2024-07-23T08:36:15-0400"}}