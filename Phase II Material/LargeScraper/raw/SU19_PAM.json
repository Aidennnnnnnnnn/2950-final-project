s": [], "sessionCode": "SP2", "sessionBeginDt": "05/29/2019", "sessionEndDt": "08/06/2019", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Population problems are central to societal change in numerous areas- inequality, immigration and diversity, race relations, family life, health and aging, and social welfare systems. This class explores the causes and consequences of population change, paying particular attention to how population processes interact with the social, economic, and political context in which they play out. Particular attention will be paid to contemporary debates unfolding in Europe, how population \"problems\" are defined, and the policies intended to solve them.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "Recommended prerequisite: SOC 1101\u00a0or DSOC 1101, and DSOC 2010\u00a0or PAM 2030.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "Course fee: TBA.", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Develop cognitive skill: increase understanding of social scientific perspectives on the causes and consequences of population change.  Evaluate models of explanations for population changing, including fertility and family building, migration and immigration, morbidity and mortality, and aging, comparing the United States with European countries, and drawing from approaches in demography, sociology, and economics.", "Evaluate current social and political processes: critically assess existing policies on immigration and immigrant adaptation, family well-being, Poverty, aging, and work-family balance, and develop empirical and cost/benefit tools to evaluate their impacts.", "Collect and analyze data: assignments require use and examination of census data from across different countries, and uses basic descriptive statistical tools.", "Improve professional writing skills: assignments require writing oriented toward professional audiences, including demographic descriptions, a comparative paper, and a policy brief.", "Develop interpersonal skills: group discussions; group-based presentation of supplemental reading increase oral communication and interpersonal relationship skills."], "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 370478, "crseOfferNbr": 1, "subject": "PAM", "catalogNbr": "5283", "titleShort": "Population Hlth for Executives", "titleLong": "Population Health for Executives", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1760, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "05:30PM", "startDt": "06/24/2019", "endDt": "06/24/2019", "instructors": [{"instrAssignSeq": 1, "netid": "jhc48", "firstName": "Julie", "middleName": "H.", "lastName": "Carmalt"}], "pattern": "M", "facilityDescr": "ILR Conference Center 423", "bldgDescr": "ILR Conference Center", "facilityDescrshort": "ICC423", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "10:30AM", "timeEnd": "05:30PM", "startDt": "06/26/2019", "endDt": "06/26/2019", "instructors": [], "pattern": "W", "facilityDescr": "Warren Hall B25", "bldgDescr": "Warren Hall", "facilityDescrshort": "WRNB25", "meetingTopicDescription": ""}, {"classMtgNbr": 3, "timeStart": "08:00AM", "timeEnd": "05:30PM", "startDt": "06/27/2019", "endDt": "06/27/2019", "instructors": [], "pattern": "R", "facilityDescr": "Warren Hall B25", "bldgDescr": "Warren Hall", "facilityDescrshort": "WRNB25", "meetingTopicDescription": ""}, {"classMtgNbr": 4, "timeStart": "08:00AM", "timeEnd": "12:30PM", "startDt": "06/28/2019", "endDt": "06/28/2019", "instructors": [], "patte