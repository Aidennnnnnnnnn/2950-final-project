Ids": null}], "description": "Through discussion, debate, and writing, this course explores the rewards, challenges, and opportunities presented by the rapid evolution of computing and information science in areas such as science, medicine, the arts, commerce, and entertainment. It explores ideas and technologies of the field and their role in society from legal, historical, and cultural perspectives. Students are introduced to the user-centered development life cycle for web site design with a focus on critique and usability testing. Students are exposed to some of the underpinnings of artificial intelligence and learn fundamental computer programming concepts through the manipulation of digital media.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 358516, "crseOfferNbr": 1, "subject": "CS", "catalogNbr": "1610", "titleShort": "Computing in the Arts", "titleLong": "Computing in the Arts", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1532, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "06/25/2018", "endDt": "08/03/2018", "instructors": [{"instrAssignSeq": 3, "netid": "gob1", "firstName": "Graeme", "middleName": "Orman", "lastName": "Bailey"}], "pattern": "MTWRF", "facilityDescr": "Uris Hall 262", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH262", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3057"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/25/2018", "endDt": "08/03/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGRI", "catalogNbr": "1610", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "1465", "type": "C"}, {"subject": "PMA", "catalogNbr": "1640", "type": "C"}, {"subject": "PSYCH", "catalogNbr": "1650", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/25/2018", "sessionEndDt": "08/03/2018", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "Over the centuries, artists in a wide variety of media have employed many approaches to the creative process, ranging from the philosophical to the mechanical to the virtual. This course unravels some of the mysteries going on inside software used for art and music. It looks at ways of breaking things apart and sampling and ways of putting things together and resynthesizing, and explores ideas for creation. This course does not teach software packages for creating art and music. The course complements ART 2701\u00a0and MUSIC 1421.", "catalogBreadth": "", "catalogDistr": "(LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "Good comfort level with computers and some of the arts recommended.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Understand, manipulate, and design algorithms and other processes for creating music and other art forms. Specific techniques may draw from stochastic, iterative, algebraic and geometric methods, amongst others.", "Have a degree of understanding of the design process \u2014idea, formulation, specification, implementation, testing to refinement \u2014 and the development of effective interfaces.", "Have a basic understanding of the basics of probability, group theory, basic programming, feedback systems, sampling, and synthesis with emphasis on building applications via assisted process control (principles of simple programming)."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 351444, "crseOfferNbr": 5, "subject": "CS", "catalogNbr": "1710", "titleShort": "Intro to Cognitive Science", "titleLong": "Introduction to Cognitive Science", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1338, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "06/25/2018", "endDt": "08/03/2018", "instructors": [{"instrAssignSeq": 4, "netid": "ci36", "firstName": "Catalina", "middleName": "", "lastName": "Iricinschi"}], "pattern": "MTWRF", "facilityDescr": "Uris Hall 202", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH202", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1684"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/25/2018", "endDt": "08/03/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COGST", "catalogNbr": "1101", "type": "C"}, {"subject": "LING", "catalogNbr": "1170", "type": "C"}, {"subject": "PHIL", "catalogNbr": "1910", "type": "C"}, {"subject": "PSYCH", "catalogNbr": "1102", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/25/2018", "sessionEndDt": "08/03/2018", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "This course provides an introduction to the science of the mind.\u00a0 Most people have privileged access to one mind, yet this internal experience is often misleading and provides little insight into how minds emerge from physical entities like brains (or other substrates). Instead, an objective, deliberated, and multidisciplinary approach is necessary.\u00a0 To that end, cognitive science draws on, and integrates, at least five disciplines: Psychology, Neuroscience, Computer Science, Linguistics, and Philosophy.\u00a0 This course provides an introduction to the insights that these disciplines offer cognitive science while introducing students to current understanding of attention, memory, visual perception, learning, problem solving, language comprehension, and consciousness.\u00a0", "catalogBreadth": "", "catalogDistr": "(KCM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, summer (six-week session).", "catalogComments": "A 1 credit Writing in the Majors sections is available.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 358546, "crseOfferNbr": 1, "subject": "CS", "catalogNbr": "2110", "titleShort": "Obj-Oriented Prog & Data Struc", "titleLong": "Object-Oriented Programming and Data Structures", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1154, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "11:15AM", "startDt": "06/25/2018", "endDt": "08/03/2018", "instructors": [{"instrAssignSeq": 3, "netid": "nsc36", "firstName": "Natacha", "middleName": "Siobhan Chomley", "lastName": "Crooks"}], "pattern": "MTWRF", "facilityDescr": "Hollister Hall 110", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS110", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2952"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/25/2018", "endDt": "08/03/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGRD", "catalogNbr": "2110", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/25/2018", "sessionEndDt": "08/03/2018", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "Intermediate programming in a high-level language and introduction to computer science. Topics include program structure and organization, object-oriented programming (classes, objects, types, sub-typing), graphical user interfaces, algorithm analysis (asymptotic complexity, big \"O\" notation), recursion, data structures (lists, trees, stacks, queues, heaps, search trees, hash tables, graphs), graph algorithms. Java is the principal programming language.", "catalogBreadth": "", "catalogDistr": "(MQR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, spring, summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite:\u00a0CS 1110\u00a0or CS 1112\u00a0or CS 1114\u00a0or CS 1115\u00a0or equivalent course on programming in a procedural language.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Be fluent in the use of recursion and object-oriented programming concepts (e.g. classes, objects, inheritance, and interfaces).", "Be able to design and implement nontrivial Java programs (roughly 1000 lines of code), starting from an English language specification.", "Understand graphical user interfaces (GUIs), as expressed in Java.", "Understand asymptotic complexity of algorithms and be able to analyze programs to determine their running times.", "Understand basic data structures taught in the course and be able to implement them and use them in programs."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 358572, "crseOfferNbr": 1, "subject": "CS", "catalogNbr": "4410", "titleShort": "Operating Systems", "titleLong": "Operating Systems", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1134, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "09:45AM", "startDt": "07/05/2018", "endDt": "08/15/2018", "instructors": [{"instrAssignSeq": 3, "netid": "mdg39", "firstName": "Michael", "middleName": "David", "lastName": "George"}], "pattern": "MTWRF", "facilityDescr": "Upson Hall 216", "bldgDescr": "Upson Hall", "facilityDescrshort": "UPS216", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2953"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/05/2018", "endDt": "08/15/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Introduction to the design of systems programs, with emphasis on multiprogrammed operating systems. Topics include concurrency, synchronization, deadlocks, memory management, protection, input-output methods, networking, file systems and security. The impact of network and distributed computing environments on operating systems is also discussed.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, spring, summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: CS 3410\u00a0or CS 3420.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 358595, "crseOfferNbr": 1, "subject": "CS", "catalogNbr": "4820", "titleShort": "Intro Analysis of Algorithms", "titleLong": "Introduction to Analysis of Algorithms", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1161, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "09:45AM", "startDt": "05/24/2018", "endDt": "07/04/2018", "instructors": [{"instrAssignSeq": 3, "netid": "ase54", "firstName": "Ali", "middleName": "Sait", "lastName": "Erkan"}], "pattern": "MTWRF", "facilityDescr": "Hollister Hall 312", "bldgDescr": "Hollister Hall", "facilityDescrshort": "HLS312", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2954"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/24/2018", "endDt": "07/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "ins