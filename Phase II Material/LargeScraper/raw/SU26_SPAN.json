riaIds": []}], "description": "This course, which is required for the major, is designed to help the learner develop increased accuracy and sophistication in writing in Spanish for academic purposes and continued oral practice in Spanish. To this end, there will be ample writing and revising practice, with a focus on specific grammatical and lexical areas, customized to the needs of the students enrolled in the course.  All writing will be based on a particular theme relating to Latin America with a focus on film, literary texts, newspaper readings and conducting an interview.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "SPAN 2095 or CASE Q++ or permission of instructor required.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026SP, 2025FA, 2025SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 359170, "crseOfferNbr": 1, "subject": "SPAN", "catalogNbr": "2230", "titleShort": "Perspectives on Spain", "titleLong": "Perspectives on Spain", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "EUAREA", "descr": "European Studies Area", "descrformal": "European Studies Area", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0004", "crseAttrValue": "LAAREA", "descr": "Latin American Studies Area", "descrformal": "Latin American Studies Area", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}, {"crseAttr": "0004", "crseAttrValue":