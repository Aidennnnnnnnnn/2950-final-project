gy. This course covers four major algorithm design techniques (greedy algorithms, divide-and-conquer, dynamic programming, and network flow), undecidability and NP-completeness, and algorithmic techniques for intractable problems (including identification of structured special cases , approximation algorithms, local search heuristics, and online algorithms).", "catalogBreadth": null, "catalogDistr": "(SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": null, "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "Students who got an A- \u200b(or, when taken in Spring 2020, C- or S)\u00a0or better in both\u00a0CS 2800\u00a0and\u00a0CS 2110\u00a0are welcome to take CS 4820 without CS 3110.", "catalogPrereqCoreq": "Prerequisite: CS 2800, CS 3110.\u00a0", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": "2025FA, 2025SU, 2025SP, 2024FA", "exploreCriteriaIds": []}, {"strm": 2902, "crseId": 358600, "crseOfferNbr": 1, "subject": "CS", "catalogNbr": "4999", "titleShort": "Independent Reading & Research", "titleLong": "Independent Reading and Research", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 2026, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/02/2025", "endDt": "07/11/2025", "instructors": [{"instrAssignSeq": 2, "netid": "sg2385", "firstName": "Sainyam", "middleName": "", "lastName": "Galhotra"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAI