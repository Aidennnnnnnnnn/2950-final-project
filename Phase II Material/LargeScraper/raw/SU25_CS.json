 "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1408, "meetings": [{"classMtgNbr": 1, "timeStart": "09:30AM", "timeEnd": "12:15PM", "startDt": "06/23/2025", "endDt": "07/11/2025", "instructors": [{"instrAssignSeq": 11, "netid": "gob1", "firstName": "Graeme", "middleName": "Orman", "lastName": "Bailey"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/23/2025", "endDt": "07/12/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ENGRI", "catalogNbr": "1610", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "1465", "type": "C"}, {"subject": "PSYCH", "catalogNbr": "1650", "type": "C"}], "sessionCode": "3W2", "sessionBeginDt": "06/23/2025", "sessionEndDt": "07/11/2025", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}], "description": "Over the centuries, artists in a wide variety of media have employed many approaches to the creative process, ranging from the philosophical to the mechanical to the virtual. This course unravels some of the mysteries going on inside software used for art and music. It looks at ways of breaking things apart and sampling and ways of putting things together and resynthesizing, and explores ideas for creation. This course does not teach software packages for creating art and music. The course complements ART 2701\u00a0and MUSIC 1421.", "catalogBreadth": null, "catalogDistr": "(SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": null, "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "Good comfort level with computers and some of the arts recommended.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Understand, manipulate, and design algorithms and other processes for creating music and other art forms. Specific techniques may draw from stochastic, iterative, algebraic and geometric methods, amongst others.", "Have a degree of understanding of the design process \u2014idea, formulation, specification, implementation, testing to refinement \u2014 and the development of effective interfaces.", "Have a basic understanding of the basics of probability, group theory, basic programming, feedback systems, sampling, and synthesis with emphasis on building applications via assisted process control (principles of simple programming)."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": "2025SU, 2024SU, 2023SU, 2022SU", "exploreCriteriaIds": []}, {"strm": 2902, "crseId": 351444, "crseOfferNbr": 5, "subject": "CS", "catalogNbr": "1710", "titleShort": "Intro to Cognitive Science", "titleLong": "Introduction to Cognitive Science", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1462, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "06/23/2025", "endDt": "08/01/2025", "instructors": [{"instrAssignSeq": 4, "netid": "rc799", "firstName": "Ruiyi", "middleName": "", "lastName": "Chen"}], "pattern": "MTWRF", "meetingTopicDescrip