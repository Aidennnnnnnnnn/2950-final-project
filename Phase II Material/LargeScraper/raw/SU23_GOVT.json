ubject": "ASRC", "catalogNbr": "2063", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/30/2023", "sessionEndDt": "08/19/2023", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": []}], "description": "This course is offers students a platform for critical examination of the political, historical, educational, social and economic conditions of the African continent. Topics will include eradication of poverty, access to nutrition, health care, clean water and energy, education, elimination of inequality with a special emphasis on gender equity, sustainable and environmentally sensitive industrial development, responsible consumption, protection of land and life below water, promotion of sustainable communities and global peace and partnership.", "catalogBreadth": "(GHB)", "catalogDistr": "(HA-AS, GLC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 359630, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3071", "titleShort": "Enduring Global & Amer Issues", "titleLong": "Enduring Global and American Issues", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1906, "meetings": [{"classMtgNbr": 1, "timeStart": "06:30PM", "timeEnd": "10:00PM", "startDt": "06/05/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 5, "netid": "ds90", "firstName": "David", "middleName": "", "lastName": "Silbey"}], "pattern": "TR", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Washington, DC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3541"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "DC", "locationDescr": "Washington, DC", "startDt": "06/05/2023", "endDt": "07/28/2023", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3071", "type": "C"}, {"subject": "PAM", "catalogNbr": "3071", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/30/2023", "sessionEndDt": "08/19/2023", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": []}], "description": "The US and the global community face a number of complex, interconnected and enduring issues that pose challenges for our political and policy governance institutions and society at large.\u00a0 Exploring how the US and the world conceive of the challenges and take action on them is fundamental to understanding them.\u00a0 This course investigates such issues, especially ones that fit into the critically important areas of sustainability, social justice, technology, public health and globalization, security and conflict, among others. Students will engage with these areas and issues and the challenges they pose, using multiple frameworks and approaches, through weekly class discussions and lectures.\"", "catalogBreadth": "", "catalogDistr": "(GLC-AS, SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 351417, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3141", "titleShort": "Prisons", "titleLong": "Prisons", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1248, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/30/2023", "endDt": "06/16/2023", "instructors": [{"instrAssignSeq": 4, "netid": "mcs378", "firstName": "Matthew", "middleName": "C", "lastName": "Saleh"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1883"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/30/2023", "endDt": "06/16/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3141", "type": "C"}], "sessionCode": "3W1", "sessionBeginDt": "05/30/2023", "sessionEndDt": "06/16/2023", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "The United States stands alone among Western, industrialized countries with its persistent, high rates of incarceration, long sentences, and continued use of the death penalty. This \"American exceptionalism\" -- the turn to mass incarceration -- has been fostered by the use of sharply-delineated categories that define vast numbers of people as outlaws and others as law-abiding. These categories that are based on ideas of personal responsibility and\u00a0assumptions about race are modified somewhat by a liberal commitment to human rights.\u00a0\u00a0 Our purpose in this course is to understand how such ideas have taken root and to locate the consequences of these ideas for policy and practice.\u00a0", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 359631, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3150", "titleShort": "The Amer Legal System", "titleLong": "The American Legal System", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1250, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "06/05/2023", "endDt": "06/28/2023", "instructors": [{"instrAssignSeq": 3, "netid": "ces78", "firstName": "Charles", "middleName": "Evan", "lastName": "Stewart"}], "pattern": "MTWRF", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1747"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "CENYC", "locationDescr": "Continuing Ed in NYC", "startDt": "06/05/2023", "endDt": "06/28/2023", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/30/2023", "sessionEndDt": "08/19/2023", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": []}], "description": "This course offers a comprehensive introduction to the American legal system, its roots in natural and common law, the purposes/values it serves (e.g., resolution of private grievances; punishment of offenses against the polity and individuals; preservation, development, and limitation of individual and group rights; and facilitation of commerce and private agreements), and the roles of the judiciary, legislature, and private parties. The course is taught using the Socratic method employed at most US law schools and introduces students to fundamental concepts and techniques used by attorneys and courts in analyzing cases, interpreting statutes, and determining disputes. As in law school, students are expected to read assigned materials before each class meeting and to participate actively in class discussions. For additional information, see the\u00a0Summer Session website.\n\u00a0", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 370855, "crseOfferNbr": 1, "subject": "GOVT", "catalogNbr": "3686", "titleShort": "What Makes Us Human?", "titleLong": "What Makes Us Human? An Existential Journey Amidst Crises", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 1306, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/20/2023", "endDt": "07/07/2023", "instructors": [{"instrAssignSeq": 4, "netid": "ua42", "firstName": "Uriel", "middleName": "", "lastName": "Abulof"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3339"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/07/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W2", "sessionBeginDt": "06/20/2023", "sessionEndDt": "07/07/2023", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}, {"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1252, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "07/10/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 4, "netid": "ua42", "firstName": "Uriel", "middleName": "", "lastName": "Abulof"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3339"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/10/2023", "endDt": "07/28/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W3", "sessionBeginDt": "07/10/2023", "sessionEndDt": "07/28/2023", "sessionLong": "Three Week - Three", "exploreCriteriaIds": []}], "description": "\"What's true of all the evils in the world is true of plague as well. It helps men to rise above themselves,\" wrote Albert Camus in The Plague. It is not just the current pandemic: climate change, warlike politics, polarization, tribalism, raging anxieties, AI advancement \u2013 these are just some of the many existential troubles and challenges we all, and our very \"human nature,\" now face. This is our time to realize our humanity: find out what sets us apart as humans, and live up to it.\nThis course invites you to an existential odyssey into the human condition and politics. Are we truly different from animals and machines? What does it mean to \"be yourself\"? What's the difference between freedom and liberty? Should we pursue happiness? Why do we yield to fear and anxiety? Is the search for meaning meaningless? Do we live in a post-truth era? What are the roles of morality in our society and politics? Why is God dead, but religion alive? Can we defeat alienation? Is love all we need? How much can, and should, we hope for? In this course, utilizing\u00a0the award-winning edX HOPE (Human Odyssey to Political Existentialism; see https://tinyurl.com/hope44), we will address these questions, and then some more. We shall examine a dozen themes, entwining each with critical reflections, both personal and political, amidst the current crisis: Human/nature, identity &amp; authenticity, freedom, reflection, happiness, death &amp; dread, meaning, morality, truth &amp; trust, God &amp; religion, alienation &amp; love, and finally \u2013 hope.", "catalogBreadth": "", "catalogDistr": "(ETM-AS, KCM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(AM, CP, IR, PT)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 368788, "crseOfferNbr": 2, "subject": "GOVT", "catalogNbr": "3887", "titleShort": "Int'l Human Rights Theo & Prac", "titleLong": "International Human Rights in Theory and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1273, "meetings": [{"classMtgNbr": 1, "timeStart": "10:30AM", "timeEnd": "11:45AM", "startDt": "06/20/2023", "endDt": "07/07/2023", "instructors": [{"instrAssignSeq": 6, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "12:00PM", "timeEnd": "01:00PM", "startDt": "06/20/2023", "endDt": "07/07/2023", "instructors": [], "pattern": "MW", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3227"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/07/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "SD", "instrModeDescrshort": "DL-SD", "instrModeDescr": "Distance Learning-Synchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "LAW", "catalogNbr": "3887", "type": "C"}], "sessionCode": "3W2", "sessionBeginDt": "06/20/2023", "sessionEndDt": "07/07/2023", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}], "description": "This course will introduce students to the law, theory, and practice of international human rights. Students will think critically about the effectiveness of the\u00a0international human rights system by examining its successes, failures, and dilemmas in preventing and responding to human rights abuse. Topics covered will include the origins and foundations of international human rights; the role of international, regional,\u00a0and domestic institutions and actors in enforcing human rights; critiques of the human rights movement; and the relationship of the\u00a0United States to the international system for the protection of human rights. The course will also explore issues such as the\u00a0death penalty, women's human rights, migration, climate change, global poverty, racism and xenophobia, and responses to mass atrocities. During in-class activities, students will have the opportunity to step into the shoes of a human rights advocate and work\u00a0with their classmates to address simulated human rights problems.", "catalogBreadth": "(GB)", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "(IR)", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2023-0