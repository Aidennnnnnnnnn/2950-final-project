{"status": "success", "data": {"classes": [{"strm": 2832, "crseId": 362024, "crseOfferNbr": 1, "subject": "NBA", "catalogNbr": "5920", "titleShort": "Experience in Int'l Management", "titleLong": "Experience in International Management", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "FLD", "ssrComponentLong": "Field Studies", "section": "802", "classNbr": 1110, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/05/2023", "endDt": "01/21/2023", "instructors": [{"instrAssignSeq": 1, "netid": "mm462", "firstName": "Mark", "middleName": "B.", "lastName": "Milstein"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "International Trip to Japan."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "OTHINTL", "locationDescr": "Other International", "startDt": "01/05/2023", "endDt": "01/21/2023", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "Japan", "openStatus": "C", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1.5, "unitsMaximum": 1.5, "componentsOptional": [], "componentsRequired": ["FLD"], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "12/26/2022", "sessionEndDt": "01/21/2023", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Combines classroom sessions and international experience with an increased awareness of business environments outside the United States. On trips, students visit local businesses, subsidiaries of foreign multinationals, government officials, local business school students, and others. Students also must attend two pre-trip meetings during the semester (2-1/2 hours each). These meetings are used to present information on international business conditions, industrial structures, management styles, and also to develop cross-cultural skills.\u00a0A final paper, integrating the material learned in the classroom with their experiences, is required. Students in some treks do pro bono consulting projects for small and medium size companies. Hence, the PowerPoint is the deliverable in those cases.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-ITL)", "catalogWhenOffered": "Winter, Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "Field trip fee: TBA; required faculty-approved study trip.", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Johnson School students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2832, "crseId": 365616, "crseOfferNbr": 1, "subject": "NBA", "catalogNbr": "5925", "titleShort": "Johnson Exp. Ldrshp Expedition", "titleLong": "Johnson Experiential Leadership Expedition", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "FLD", "ssrComponentLong": "Field Studies", "section": "801", "classNbr": 1149, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/04/2023", "endDt": "01/16/2023", "instructors": [{"instrAssignSeq": 1, "netid": "lac53", "firstName": "Laura", "middleName": "C", "lastName": "Georgianna"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": null}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Patagonia, Chile."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "OTHI