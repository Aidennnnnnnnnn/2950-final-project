location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/21/2022", "endDt": "07/29/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/21/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "An introductory course in the theory, practice, and reading of fiction, poetry, and allied forms. Both narrative and verse readings are assigned. Students will learn to savor and practice the craft of poetry and narrative writing, developing techniques that inform both. Some class meetings may feature peer review of student work, and instructors may assign writing exercises or prompts.", "catalogBreadth": "", "catalogDistr": "(LA-AS, ALC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "ENGL 2800 and ENGL 2810\u00a0cannot be counted towards the English major. ENGL 2800 and ENGL 2810\u00a0are the same course, the former offered in fall, the latter in spring. Attendance Policy: Pre-enrolled students are required to attend the first two meetings of the course. Those missing the first two class sessions may be removed from the roster.", "catalogPrereqCoreq": "Prerequisite: completion of the First-Year Writing Seminar (FWS) requirement. Students should not take an FWS and ENGL 2800 simultaneously.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "ENGL 2800 or\u00a0ENGL 2810\u00a0is the prerequisite for 3000-level creative writing courses. ENGL 2800 or 2810\u00a0is required for the Creative Writing minor. Additionally, the course can be used to fulfill distribution requirements in the humanities for Arts &amp; Sciences and most other colleges.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 372549, "crseOfferNbr": 2, "subject": "ENGL", "catalogNbr": "3941", "titleShort": "Political Journalism", "titleLong": "Political Journalism", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1961, "meetings": [{"classMtgNbr": 1, "timeStart": "06:30PM", "timeEnd": "09:30PM", "startDt": "06/06/2022", "endDt": "07/27/2022", "instructors": [], "pattern": "MW", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in Washington, DC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3490"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "DC", "locationDescr": "Washington, DC", "startDt": "06/06/2022", "endDt": "07/27/2022", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "AMST", "catalogNbr": "3145", "type": "C"}, {"subject": "COMM", "catalogNbr": "3140", "type": "C"}, {"subject": "GOVT", "catalogNbr": "3221", "type": "C"}, {"subject": "PAM", "catalogNbr": "3140", "type": "C"}], "sessionCode": "SP2", "sessionBeginDt": "05/30/2022", "sessionEndDt": "08/20/2022", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": []}], "description": "This course will explore the traditional dynamic and norms of political press coverage in the United States, and the impact of those patterns on both the government and the nation; some of the ways longstanding norms have recently shifted, and continue to shift; the larger historical forces and long-term trends driving those changes; and the theoretical questions, logistical challenges and ethical dilemmas these changes pose for both political journalists and those they cover. The course will equally cover the practice of political reporting, including weekly analysis and discussion of current press coverage, in-class exercises and simulations, readings from academic and journalistic sources, and visits from leading political reporters and former spokespeople able to offer a firsthand perspective on the topics.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Demonstrate the ability to \"think like a journalist,\" in particular: to understand and interpret the elements of a variety of political reporting, and the editorial decision-making process.", "Understand, analyze, and contrast how the press and political actors influence each other, and society at large.", "Compose, evaluate, and assess editorial decisions in real time.", "Interpret and utilize the basic facts about how various political news beats and platforms operate, including congressional, White House, campaign, investigative, local, print, digital and television journalism."], "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-09-01T07:41:12-0400", "catalogDttm": "2022-08-09T08:17:01-0400"}}