 will provide examples of where businesses have committed human rights violations. International laws and norms increasingly govern business and human rights. These regulations guide businesses on how to better design better compliance mechanisms to ensure best practices in protecting human rights globally.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": null, "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "lastTermsOffered": "2025SU, 2024SU, 2023SU, 2022SU", "exploreCriteriaIds": []}, {"strm": 2902, "crseId": 371222, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "5113", "titleShort": "U.S. Antitrust Law and Policy", "titleLong": "U.S. Antitrust Law and Policy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1743, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/12/2025", "endDt": "06/29/2025", "instructors": [{"instrAssignSeq": 1, "netid": "gah7", "firstName": "George", "middleName": "Alan", "lastName": "Hay"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: Master of Science Legal Studies (MSLS) program students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/12/2025", "endDt": "06/29/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescripti