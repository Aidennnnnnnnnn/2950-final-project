{"status": "success", "data": {"classes": [{"strm": 2734, "crseId": 352730, "crseOfferNbr": 1, "subject": "LING", "catalogNbr": "1111", "titleShort": "American Sign Language I", "titleLong": "American Sign Language I", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1152, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "09:45AM", "startDt": "06/24/2019", "endDt": "08/02/2019", "instructors": [{"instrAssignSeq": 3, "netid": "trg1", "firstName": "Teresa", "middleName": "R.", "lastName": "Galloway"}], "pattern": "MTWRF", "facilityDescr": "Morrill Hall 111", "bldgDescr": "Morrill Hall", "facilityDescrshort": "MRL111", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1893"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2019", "endDt": "08/02/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2019", "sessionEndDt": "08/02/2019", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "Students with no previous background in American Sign Language (ASL) are introduced to the nature of a signed language and develop expressive and receptive skills in ASL. Basic grammar and vocabulary are covered, including explanations of the fundamental parts of a sign, proper use of fingerspelling, and the significance of nonmanual features. Instruction is supplemented with videotexts allowing students to begin to explore the visual literature of the Deaf community in the United States-stories, poems, and jokes that are unique to Deaf culture. Readings and class discussions acquaint students with the causes of deafness, the historical development of ASL and its linguistic status, and characteristics of deaf education both throughout history and in the present day.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 351444, "crseOfferNbr": 3, "subject": "LING", "catalogNbr": "1170", "titleShort": "Intro to Cognitive Science", "titleLong": "Introduction to Cognitive Science", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1082, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "02:15PM", "startDt": "06/24/2019", "endDt": "08/02/2019", "instructors": [{"instrAssignSeq": 3, "netid": "jrw369", "firstName": "Mia", "middleName": "", "lastName": "Wiegand"}], "pattern": "MTWRF", "facilityDescr": "Uris Hall 202", "bldgDescr": "Uris Hall", "facilityDescrshort": "URH202", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1710"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2019", "endDt": "08/02/2019", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COGST", "catalogNbr": "1101", "type": "C"}, {"subject": "CS", "catalogNbr": "1710", "type": "C"}, {"subject": "PHIL", "catalogNbr": "1910", "type": "C"}, {"subject": "PSYCH", "catalogNbr": "1102", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/24/2019", "sessionEndDt": "08/02/2019", "sessionLong": "Six Week Summer", "exploreCriteriaIds": null}], "description": "This course provides an introduction to the science of the mind.\u00a0 Everyone knows what it's like to think and perceive, but this subjective experience provides little insight into how minds emerge from physical intities like brains.\u00a0 To address this issue, cognitive science integrates work from at least five disciplines: Psychology, Neuroscience, Computer Science, Linguistics, and Philosophy.\u00a0 This course introduces students to the insights these disciplines offer into the workings of the mind by exploring visual perception, attention, memory, learning, problem solving, language, and consciousness.\u00a0", "catalogBreadth": "", "catalogDistr": "(KCM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, Summer (six-week session).", "cat