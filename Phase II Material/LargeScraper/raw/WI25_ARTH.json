{"status": "success", "data": {"classes": [{"strm": 2888, "crseId": 350883, "crseOfferNbr": 1, "subject": "ARTH", "catalogNbr": "2200", "titleShort": "Classical World in 24 Objects", "titleLong": "Introduction to the Classical World in 24 Objects", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1148, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/02/2025", "endDt": "01/17/2025", "instructors": [{"instrAssignSeq": 5, "netid": "vjp33", "firstName": "Verity", "middleName": "Jane", "lastName": "Platt"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Winter Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/02/2025", "endDt": "01/18/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRI", "gradingBasisShort": "GradeNoAud", "gradingBasisLong": "Letter grades only (no audit)", "simpleCombinations": [{"subject": "ARKEO", "catalogNbr": "2700", "type": "C"}, {"subject": "CLASS", "catalogNbr": "2700", "type": "C"}], "sessionCode": "WS", "sessionBeginDt": "01/02/2025", "sessionEndDt": "01/17/2025", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "The art of Ancient Greece and Rome has a complex legacy within western culture that is inseparable from ideas about power, beauty, identity, and knowledge. As such, 'Classical' art has been appropriated for all kinds of ends, many of them deeply problematic. But what did ancient statues, paintings, vessels, or buildings mean for the cultures that originally created, viewed, and lived alongside them? How were they embedded within political and social structures, religious practices, and public or domestic spaces? What can they tell us about practices of representation and story-telling? How might they help us access ancient attitudes to gender, ethnicity, or social status? And why is any of this still relevant today? This course on Greek and Roman art and archaeology will address all these questions. Covering the time span from the Bronze Age (3rd millennium BCE) to the late Roman Empire (4th century CE), we will focus on one object or monument each lecture, considering how it can be considered exemplary for its time. Where possible, we will engage with artefacts in our collections at Cornell, including the plaster-casts, as we develop skills in viewing, analyzing, and contextualizing material evidence.", "catalogBreadth": null, "catalogDistr": "(ALC-AS) (CA-AG, LA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2888, "crseId": 372863, "crseOfferNbr": 3, "subject": "ARTH", "catalogNbr": "3590", "titleShort": "Heritage, History, Identity", "titleLong": "Heritage, History, and Identity in Cambodia", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrCompone