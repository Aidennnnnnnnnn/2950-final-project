, "sessionBeginDt": "07/13/2020", "sessionEndDt": "07/31/2020", "sessionLong": "Three Week - Three", "exploreCriteriaIds": null}], "description": "Working with cameras, audio recorders, physical computing boards and computer software, this course introduces students to digital art creation, manipulation and theory. Students will have hands on experience with digital image acquisition, recording and editing video and sound, and computer programming for interactive media based applications. Learning will be fun, challenging, exciting and will open the student to new possibilities for creating dynamic media art. Topics addressed during the course will include digital photography, digital video, audio and video editing, stop-animation, slow-motion video, macro photography, programming for audio/ visual interaction, and physical computing.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "Counts as free elective credit for B.F.A. students.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 369453, "crseOfferNbr": 1, "subject": "ART", "catalogNbr": "1103", "titleShort": "Art as Experience: Sculpture", "titleLong": "Art as Experience: Sculpture", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 1014, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "07/13/2020", "endDt": "07/31/2020", "instructors": [{"instrAssignSeq": 4, "netid": "cjo37", "firstName": "Christopher", "middleName": "J.", "lastName": "Oliver"}], "pattern":