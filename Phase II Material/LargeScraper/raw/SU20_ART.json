ecide what our work is about. This is what makes sculpture so powerful and exciting, and also so challenging. This course begins by exploring these givens though a number of very specific assignments and discussions. After a level of class-wide proficiency has been attained each student will develop their own line of inquiry and develop highly individualized projects.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Free elective for B.F.A. students.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AR", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2762, "crseId": 371151, "crseOfferNbr": 1, "subject": "ART", "catalogNbr": "1601", "titleShort": "Intro to Digital Photo", "titleLong": "Introduction to Digital Photography", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "STU", "ssrComponentLong": "Studio", "section": "501", "classNbr": 1863, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/22/2020", "endDt": "07/31/2020", "instructors": [{"instrAssignSeq": 4, "netid": "bap8", "firstName": "Barry", "middleName": "Allan", "lastName": "Perlus"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/22/2020", "endDt": "07/31/2020", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "