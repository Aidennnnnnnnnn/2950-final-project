ups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1260, "meetings": [{"classMtgNbr": 1, "timeStart": "08:00AM", "timeEnd": "05:00PM", "startDt": "06/04/2018", "endDt": "07/27/2018", "instructors": [{"instrAssignSeq": 2, "netid": "sb43", "firstName": "Sam", "middleName": "", "lastName": "Beck"}], "pattern": "MTWRF", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1392"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "CENYC", "locationDescr": "Continuing Ed in NYC", "startDt": "06/04/2018", "endDt": "07/27/2018", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This course examines\u00a0the nature of public health in practice through a reflective process on experience while participating in a public health activity.\u00a0 Students investigate a public health issue as it is carried out by an organization while coming to understand their own process of learning through experience and how this experience increases self-consciousness as a meaning maker and knowledge producer about global public health.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-SBY, CU-UGR)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 359722, "crseOfferNbr": 1, "subject": "HE", "catalogNbr": "4080", "titleShort": "Health Care Culture and Career", "titleLong": "Practicing Medicine Health Care Culture and Careers", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1229, "meetings": [{"classMtgNbr": 1, "timeStart": "08:00AM", "timeEnd": "05:00PM", "startDt": "06/04/2018", "endDt": "07/27/2018", "instructors": [{"instrAssignSeq": 2, "netid": "sb43", "firstName": "Sam", "middleName": "", "lastName": "Beck"}], "pattern": "MTWRF", "facilityDescr": "To Be Assigned", "bldgDescr": null, "facilityDescrshort": "TBA", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2324"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "CENYC", "locationDescr": "Continuing Ed in NYC", "startDt": "06/04/2018", "endDt": "07/27/2018", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Students learn through a cycle of action, experience, and reflection and as ethnographic participant observers. Over the course of the summer, students learn how to implement experience-based learning techniques and perspectives to enhance their competencies as initiates of professional medical practice. Students spend four days each week shadowing physicians in assigned NYC private or public hospitals. One day each week three different seminars engage students in exploring the world of medicine. Weill Cornell medical practitioners discuss different specialties, professional practice, opportunities and challenges in medical careers, and the culture of medicine. This is followed by two student led seminars that explore a variety of topics, experiential learning and ethnographic methods in medicine. Students use their experiences as a source for writing journals and oral reflections to improve how to engage medical learning.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "(CU-CEL, CU-SBY, CU-UGR)", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2018-09-16T19:14:21-0400", "catalogDttm": "2018-06-14T19:15:33-0400"}}