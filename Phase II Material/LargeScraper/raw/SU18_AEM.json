": true, "crseAttrs": [], "instructionMode": "DW", "instrModeDescrshort": "DL WWW", "instrModeDescr": "Distance Learning - WWW", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "NBA", "catalogNbr": "5991", "type": "W"}], "sessionCode": "3WK", "sessionBeginDt": "05/30/2018", "sessionEndDt": "06/22/2018", "sessionLong": "Three Week Summer", "exploreCriteriaIds": null}], "description": "In today's globalized and interconnected world, more and more companies are going abroad to pursue their major business objectives. How can they take advantage of the global marketplace and create economic value through their multimarket activities? This distance learning course gives students a basic grounding in global business, so they can become capable of understanding and analyzing events and trends in the global business environment and their impact on managerial decision making. Through a series of case discussions and an internationalization project for a local company, students develop practical skills in applying the tools of global strategic analysis in concrete business situations. Students registered for NBA 5991 will be required to analyze a current-event situation based on the theoretical and methodological framework developed in this course.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, summer.", "catalogComments": "This is an online distance learning course. This course contains business concepts, theoretical frameworks and analyses that meet the degree requirements for both undergraduate Business Management majors and graduate students majoring in business administration or related fields. This course also meets the requirements for the Dyson School's Intercultural and International Management Certificate.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Learn how to recognize, analyze and explain events and trends in the global environment and their impact on managerial decision making and business strategy across borders.", "Develop practical skills in applying the tools of global strategic analysis and management in concrete business situations."], "acadCareer": "UG", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 365803, "crseOfferNbr": 1, "subject": "AEM", "catalogNbr": "4545", "titleShort": "International Finance & Macro", "titleLong": "International Finance and Macroeconomics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "002", "classNbr": 1642, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "04:00PM", "startDt": "05/30/2018", "endDt": "06/22/2018", "instructors": [{"instrAssignSeq": 2, "netid": "fw257", "firstName": "FeiFei", "middleName": "", "lastName": "Wang"}], "pattern": "MTWRF", "facilityDescr": "Goldwin Smith Hall G24", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSHG24", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3202"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/30/2018", "endDt": "06/22/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "