2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "How do designers think, create, solve problems, and help humans interact with everything in our world, from spaces and places to skateboards and web sites? During this course, students interested in a career in design will learn how the creative problem-solving process is similar in a variety of design disciplines and how they can make a difference as a design professional.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "HE", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 351496, "crseOfferNbr": 1, "subject": "DEA", "catalogNbr": "1110", "titleShort": "Making a Difference by Design", "titleLong": "Making a Difference by Design", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1167, "meetings": [{"classMtgNbr": 1, "timeStart": "09:30AM", "timeEnd": "12:00PM", "startDt": "07/16/2018", "endDt": "08/03/2018", "instructors": [{"instrAssignSeq": 4, "netid": "rbh25", "firstName": "Brooke", "middleName": "", "lastName": "Hollis"}, {"instrAssignSeq": 2, "netid": "gk272", "firstName": "Gourab", "middleName": "", "lastName": "Kar"}, {"instrAssignSeq": 3, "netid": "rv54", "firstName": "Rohit", "middleName": "", "lastName": "Verma"}], "pattern": "MTWRF", "facilityDescr": "Ives Hall 111", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS111", "meetingTopicDescription": ""}], "notes": [{"classNo