ar Academic Session", "exploreCriteriaIds": []}], "description": "Appropriate and efficient internal compliance helps to support the central mission of the business and control costs. This course is designed to introduce students to the basic concepts and fundamentals of the compliance function within a company or organization. It will focus on (1) the drivers behind the development of rules (2) practical issues involved in rule creation (3) the process of training, or selling, rule systems to the appropriate people (4) policing compliance, including investigations and enforcement of rules, and (5) the consequences of failing to operate a compliance program or doing it wrong. The course relies upon case studies from businesses and organizations, with an emphasis on real life situations with the goal of understanding how to make improvements to rule systems.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Enrollment limited to: MSLS students.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025FA, 2024FA, 2023FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 371222, "crseOfferNbr": 1, "subject": "LEGAL", "catalogNbr": "5113", "titleShort": "U.S. Antitrust Law and Policy", "titleLong": "U.S. Antitrust Law and Policy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr