led models, dashboarding and business intelligence with Power BI and detailed modeling using the statistical programming language R. The course covers a wide variant of models/topic including traditional descriptive analytics (through PowerBI), predictive analytics and machine learning (through R) and prescriptive analytics including optimization and simulation (in Excel and R).", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: HADM 2010, HADM 3010, or instructor permission.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: graduate students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 373355, "crseOfferNbr": 1, "subject": "HADM", "catalogNbr": "7120", "titleShort": "Leading&Transforming Hosp Orgs", "titleLong": "Leading and Transforming Hospitality Organizations", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1914, "meetings": [{"classMtgNbr": 1, "timeStart": "06:00PM", "timeEnd": "07:30PM", "startDt": "05/22/2023", "endDt": "07/07/2023", "instructors": [{"instrAssignSeq": 1, "netid": "kmw33", "firstName": "Kate", "middleName": "M.", "lastName": "Walsh"}], "pattern": "T", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to: EMMH Students."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/22/2023", "endDt": "07/07/2023", "addConsent": "N", "addConsentDescr