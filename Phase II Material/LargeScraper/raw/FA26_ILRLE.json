inations": [], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Applies the theory and elementary tools of economics to the characteristics and problems of the labor market. Considers both the demand (employer) and supply (employee) sides of the market to gain a deeper understanding of the effects of various government programs and private decisions targeted at the labor market. Topics include employment demand, basic compensation determination, education and training, benefits and the structure of compensation, labor-force participation and its relation to household production, occupational choice, migration, labor-market discrimination, and the effects of unions.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "Priority given to: Industrial and Labor Relations (ILR) sophomores; remaining seats open to undergraduate sophomores, juniors, and seniors during the add period.", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "ECON 1110 and ECON 1120.", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2026SP, 2025FA, 2025SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 359671, "crseOfferNbr": 1, "subject": "ILRLE", "catalogNbr": "3440", "titleShort": "Development of Economic Though", "titleLong": "Development of Economic Thought and Institutions", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "HA-AG", "descr": 