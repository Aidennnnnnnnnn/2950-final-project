scr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0013", "crseAttrValue": "CU-SBY", "descr": "Sustainability", "descrformal": "Sustainability", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "WS", "sessionBeginDt": "01/04/2027", "sessionEndDt": "01/23/2027", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "Climate change, pandemics, wars and warlike politics, polarization, tribalism, raging anxieties, AI advancement - these are just some of the many existential troubles and challenges we all, and our very human nature, now face. This is our time to realize our humanity: find out what sets us apart as humans, and live up to it. This course invites you to an existential odyssey into the human condition and politics. Are we truly different from animals and machines? What does it mean to be yourself? What's the difference between freedom and liberty? Should we pursue happiness? Why do we yield to fear and anxiety? Is the search for meaning meaningless? Do we live in a post-truth era? What are the roles of morality in our society and politics? Why is God dead, but religion alive? Can we defeat alienation? Is love all we need? How much can, and should, we hope for? In this course, utilizing the award-winning edX HOPE (see https://bit.ly/Human44), we will address these questions, and then some more. We shall examine a dozen themes, entwining each with critical reflections, both personal and political, amidst the current crisis: Human/nature, identity & authenticity, freedom, reflection, happiness, death & dread, meaning, morality, truth & trust, God & religion, alienation & love, and finally - hope. (GOVT-PT)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026WI, 2025SU, 2025WI", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-10-15T19:07:30-0400"}}