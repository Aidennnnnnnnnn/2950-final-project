ssionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "This course provides an introduction to the science of the mind. Everyone knows what it's like to think and perceive, but this subjective experience provides little insight into how minds emerge from physical entities like brains. To address this issue, cognitive science integrates work from at least five disciplines: Psychology, Neuroscience, Computer Science, Linguistics, and Philosophy. This course introduces students to the insights these disciplines offer into the workings of the mind by exploring visual perception, attention, memory, learning, problem solving, language, and consciousness.\u00a0", "catalogBreadth": "", "catalogDistr": "(KCM-AS, ETM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, Summer.", "catalogComments": "A one credit Writing in the Majors section is available, COGST 1104.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 372461, "crseOfferNbr": 2, "subject": "COGST", "catalogNbr": "1112", "titleShort": "Change-making by Design", "titleLong": "Change-making: Designing Healthy & Hospitable Environments", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1513, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "12:00PM", "startDt": "07/11/2022", "endDt": "07/29/2022", "instructors": [{"instrAssignSeq": 7, "netid": "ne237", "firstName": "Nooshin", "middleName": "", "lastName": "Ahmadi"}, {"instrAssignSeq": 6, "netid": "rbh25", "firstName": "Brooke", "middleName": "", "lastName": "Hollis"}, {"instrAssignSeq": 5, "netid": "haf3", "firstName": "Heather", "middleName": "A.", "lastName": "Kolakowski"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/11/2022", "endDt": "07/29/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "DEA", "catalogNbr": "1112", "type": "C"}], "sessionCode": "3W3", "sessionBeginDt": "07/11/2022", "sessionEndDt": "07/29/2022", "sessionLong": "Three Week - Three", "exploreCriteriaIds": []}], "description": "Designing Human-Centered, Healthy and Hospitable Environments is a three-week course examining design innovations and some impacts on management/operations in hospitality, communication, business, healthcare, and senior housing. During this course students will learn how design impacts organizations and every aspect of daily life. Using case studies, familiar examples, and interactions with a variety of leaders from design, healthcare and hospitality fields, students will engage with design thinking and explore new career pathways.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Understand the relationship between health, hospitality, and design.", "Identify characteristics of service design.", "Commit to design excellence and socially responsible design.", "Explain basic ideas involved with the process of \"design thinking\".", "Describe some ways hospitality ideas can improve the design of services in healthcare."], "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 353568, "crseOfferNbr": 2, "subject": "COGST", "catalogNbr": "1500", "titleShort": "Intro to Environ. Psychology", "titleLong": "Introduction to Environmental Psychology", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1288, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "11:15AM", "startDt": "06/21/2022", "endDt": "07/29/2022", "instructors": [{"instrAssignSeq": 4, "netid": "es963", "firstName": "Elena", "middleName": "", "lastName": "Sabinson"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2783"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/21/2022", "endDt": "07/29/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "DEA", "catalogNbr": "1500", "type": "C"}, {"subject": "PSYCH", "catalogNbr": "1500", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/21/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Environmental Psychology is an interdisciplinary field concerned with how the physical environment and human behavior interrelate. Most of the course focuses on how residential environments and urban and natural settings affect human health and well-being. Students also examine how human attitudes and behaviors affect environmental quality. Issues of environmental justice and culture are included throughout. Hands-on projects plus exams.", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Provide overview of knowledge about the environment and human behavior (grounding in field).", "Understand cultural and life course diversity in human-environment interactions (sensitivity to diversity).", "Learn how to analyze problems like an environmental psychologist (develop critical thinking skill)."], "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 351490, "crseOfferNbr": 2, "subject": "COGST", "catalogNbr": "2230", "titleShort": "Intro to Behavioral Neuroscien", "titleLong": "Intro to Behavioral Neuroscience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponen