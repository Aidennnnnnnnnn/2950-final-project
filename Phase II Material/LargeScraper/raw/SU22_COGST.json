aca, NY (Main Campus)", "startDt": "06/21/2022", "endDt": "08/02/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "PSYCH", "catalogNbr": "2230", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/21/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "Introduction to psychology from a biological perspective, which focuses on brain mechanisms of behavior. Topics include the structure and function of the nervous system, physiological approaches to understanding behavior, hormones and behavior, biological bases of sensation and perception, learning and memory, cognition, emotion, and communication.", "catalogBreadth": "", "catalogDistr": "(PBSS-AS, BIO-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "May be used to satisfy Psychology major breadth requirement and as an alternative prerequisite for upper-level biopsychology courses.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 351914, "crseOfferNbr": 2, "subject": "COGST", "catalogNbr": "3660", "titleShort": "Affective & Soc Neuroscience", "titleLong": "Affective and Social Neuroscience", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1324, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/06/2022", "endDt": "07/29/2022", "instructors": [{"instrAssignSeq": 5, "netid": "ss3767", "firstName": "Saeedeh", "middleName": "", "lastName": "Sadeghi"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3462"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/06/2022", "endDt": "08/02/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "HD", "catalogNbr": "3660", "type": "C"}], "sessionCode": "8WK", "sessionBeginDt": "06/06/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Eight Week Summer", "exploreCriteriaIds": []}], "description": "Focuses on networks of brain regions that are organized around the integration of processes related to emotion and motivation. The course first explores brain pathways for processing visual, auditory, body and face movements, and tactile stimuli that comprise the raw material used to judge the emotional significance of external events. Next, brain regions involved in the (1) emotional evaluation of that sensory input, and (2) emotional expression once a significant event is identified are described. Then, brain processes underlying the special nature of human emotional experience (subjective feelings) are explored. All of these basic emotional processes are extended by placing them within widespread brain networks that modulate emotional behavior. There is an emphasis on social contexts and the development of social emotions, including social bonding and social rejection. The manner in which emotional stress influences learning and memory, with implications for PTSD, concludes the course.", "catalogBreadth": "", "catalogDistr": "(PBSS-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: PSYCH 2230\u00a0or BIONB 2220.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["learn which brain networks underlie affective and social processes, e.g., how the amygdala detects emotional threat and activates brainstem mechanisms that create the emotional responses needed to adapt to the threat; or how the medial prefrontal cortex represents the outcome expectancies associated with our plans in responding to other's intentions"], "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-09-01T07:41:12-0400", "catalogDttm": "2022-08-09T08:17:01-0400"}}