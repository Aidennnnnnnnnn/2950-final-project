enOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 370061, "crseOfferNbr": 3, "subject": "PMA", "catalogNbr": "2703", "titleShort": "Thinking Media", "titleLong": "Thinking Media", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1348, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "11:15AM", "startDt": "07/12/2021", "endDt": "07/30/2021", "instructors": [{"instrAssignSeq": 4, "netid": "jb358", "firstName": "Jeremy", "middleName": "", "lastName": "Braddock"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3345"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/12/2021", "endDt": "07/30/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "C", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "COML", "catalogNbr": "2703", "type": "C"}, {"subject": "ENGL", "catalogNbr": "2703", "type": "C"}, {"subject": "GERST", "catalogNbr": "2703", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "2703", "type": "C"}], "sessionCode": "3W3", "sessionBeginDt": "07/12/2021", "sessionEndDt": "07/30/2021", "sessionLong": "Three Week - Three", "exploreCriteriaIds": null}], "description": "From hieroglyphs to HTML, ancient poetry to audiotape, and Plato's cave to virtual reality, \"Thinking Media\" offers a multidisciplinary introduction to the most influential media formats of the last three millennia. Featuring an array of guests from across Cornell, including faculty from Communication, Comparative Literature, English, German Studies, Information Science, Music, and Performing &amp; Media Arts, the course will present diverse perspectives on how to think with, against, and about media in relation to the public sphere and private life, archaeology and science fiction, ethics and aesthetics, identity and difference, labor and play, knowledge and power, expression and surveillance, and the generation and analysis of data.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "Taught in English.\u00a0 Although designed as a three-credit course, students may elect to take this course for four credits by completing additional research components (including a piece of extended writing) and attending extra sessions, which may enable the course to satisfy certain elective requirements in various departments and programs. Please consult the instructor for further details.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 371596, "crseOfferNbr": 1, "subject": "PMA", "catalogNbr": "3501", "titleShort": "Video Essay", "titleLong": "The Video Essay", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1884, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "04:00PM", "startDt": "06/21/2021", "endDt": "07/09/2021", "instructors": [], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit https://sce.cornell.edu/courses/roster/pma-3501."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/21/2021", "endDt": "07/09/2021", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W2", "sessionBeginDt": "06/21/2021", "sessionEndDt": "07/09/2021", "sessionLong": "Three Week - Second", "exploreCriteriaIds": null}], "description": "This course examines the video essay and its corresponding or emerging forms in videographic criticism, the essay film, and written essays, including personal narrative, creative nonfiction, and hybrid texts. Students explore source material and develop media competencies that encompass video, sound, image and text in order to critically analyze content that explores dimensions of culture. In addition, students collaborate on lo-fi and more developed video projects that explore the formal dimensions of narrative and criticism. While maintaining a focus on the video essay as a form of critique, students address broader concerns about how video essays reflect their role as producers and consumers of media forms.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2021-09-09T19:14:03-0400", "catalogDttm": "2021-09-09T19:15:17-0400"}}