scrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2524"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/26/2017", "endDt": "07/14/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "DW", "instrModeDescrshort": "DL WWW", "instrModeDescr": "Distance Learning - WWW", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AEM", "catalogNbr": "3070", "type": "W"}], "sessionCode": "SP2", "sessionBeginDt": "05/31/2017", "sessionEndDt": "08/08/2017", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "This distance learning course will introduce students to the opportunities and market potential, as well as the challenges and risks of operating in emerging markets such as China, India, Brazil, Russia, Mexico, South Africa and many others. Students will learn about the various types of risk that businesses face when operating in these markets, and the major approaches to risk assessment and management. Through a combination of readings, lectures and case discussions students will gain practical skills in evaluating and assessing risk, and in developing business models and strategies that are suitable for success in emerging markets. Outcome 1: Analyze the opportunities and market potential of emerging markets. Outcome 2: Recognize the various types of risk that businesses face when operating in emerging markets, and discuss the major approaches to risk assessment and management. Outcome 3: Demonstrate practical skills in evaluating and assessing risk, and in developing business models and strategies that are suitable for success in emerging markets.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2664, "crseId": 363059, "crseOfferNbr": 1, "subject": "NBA", "catalogNbr": "5991", "titleShort": "Global Business Strategy", "titleLong": "Global Business Strategy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1494, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "05/31/2017", "endDt": "06/23/2017", "instructors": [{"instrAssignSeq": 8, "netid": "eai1", "firstName": "Elena", "middleName": "A.", "lastName": "Iankova"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2526."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/31/2017", "endDt": "06/23/2017", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "DW", "instrModeDescrshort": "DL WWW", "instrModeDescr": "Distance Learning - WWW", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "AEM", "catalogNbr": "3991", "type": "W"}], "sessionCode": "3WK", "sessionBeginDt": "05/31/2017", "sessionEndDt": "06/23/2017", "sessionLong": "Three Week Summer", "exploreCriteriaIds": null}], "description": "In today's increasingly globalized and interconnected world, international transactions as part of business are the norm. Even purely domestic firms have to deal with international issues, be it in the form of imported supplies or foreign competitors. In addition, more and more companies are going abroad to pursue their major business objectives. How can they take advantage of the global marketplace and create economic value through their multimarket activities? This course has three integrated objectives: first, to give you a basic grounding in global business, so that you can become capable of understanding and analyzing events and trends in the global business environment and their impact on managerial decision making; second, to help you understand the analytical frameworks on strategy formulation and implementation in an international context; and third, through a series of concrete case discussions and a local product internationalization project, the course aims at developing your practical skills in applying the tools of global strategic analysis in concrete business situations. Its ultimate goal is to help you become better prepared to serve in and lead business organizations in today's globalized world.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter.", "catalogComments": "Johnson School students will not receive credit for winter session courses offered through Continuing Education.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2017-08-27T19:14:21-0400", "catalogDttm": "2017-06-14T19:15:28-0400"}}