xploreCriteriaIds": []}], "description": "The Johnson Leadership Expedition is a customized leadership expedition course where students test and enhance their leadership skills in an unpredictable, challenging, and dynamic environment. This immersive leadership experience stretches and grows students' understanding of themselves as leaders as they face ambiguity and adversity, make decisions with incomplete information, and get real-time feedback on their leadership efforts. The experiential component of the expedition is combined with pre- and post-class sessions, individualized coaching sessions, and written deliverables. Students will be introduced to key leadership concepts and findings related to active leadership, followership, and judgment and decision-making under uncertainty and stress. Those learnings are then applied and reflected upon during and after the expedition.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Multi-semester course: Fall, Winter.", "catalogComments": "Students must complete NBA 5925\u00a0and NBA 5926\u00a0to receive credit.\u00a0", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2860, "crseId": 363059, "crseOfferNbr": 1, "subject": "NBA", "catalogNbr": "5991", "titleShort": "Global Business Strategy", "titleLong": "Global Business Strategy", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1142, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/02/2024", "endDt": "01/19/2024", "instructors": [{"instrAssignSeq": 5, "netid"