 context of alternative government policy programs and the impact of globalization.\u00a0 NOTE: Formerly ECON 3140.", "catalogBreadth": "", "catalogDistr": "(SBA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: with regard to overlaps between ECON 1120, ECON 3020, and ECON 3040 (formerly 3140), please refer to the\u00a0Economics section\u00a0for details.", "catalogAttribute": "", "catalogWhenOffered": "Fall, spring, summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: ECON 1110-ECON 1120\u00a0and calculus.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2629, "crseId": 365790, "crseOfferNbr": 1, "subject": "ECON", "catalogNbr": "3120", "titleShort": "Applied Econometrics", "titleLong": "Applied Econometrics", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1162, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "11:15AM", "startDt": "06/27/2016", "endDt": "08/05/2016", "instructors": [{"instrAssignSeq": 3, "netid": "gj10", "firstName": "George", "middleName": "Hersh", "lastName": "Jakubson"}], "pattern": "MTWRF", "facilityDescr": "Ives Hall 215", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS215", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3007"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/27/2016", "endDt": "08/05/2016", "addConsent": "N", "addConsentDescr