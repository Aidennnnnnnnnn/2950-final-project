: [{"subject": "GOVT", "catalogNbr": "3141", "type": "B"}], "sessionCode": "WS", "sessionBeginDt": "01/04/2027", "sessionEndDt": "01/23/2027", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "The United States stands alone among Western, industrialized countries with its persistent, high rates of incarceration, long sentences, and continued use of the death penalty. This American exceptionalism -- the turn to mass incarceration -- has been fostered by the use of sharply-delineated categories that define vast numbers of people as outlaws and others as law-abiding. These categories that are based on ideas of personal responsibility and assumptions about race are modified somewhat by a liberal commitment to human rights. Our purpose in this course is to understand how such ideas have taken root and to locate the consequences of these ideas for policy and practice. (GOVT-AM)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026WI, 2025SU, 2025WI", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2944, "crseId": 352688, "crseOfferNbr": 2, "subject": "AMST", "catalogNbr": "3410", "titleShort": "Recent Amer Hist 1965-Present", "titleLong": "Recent American History, 1965 to the Present", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "HA-AG", "descr": "AG-Historical Analysis", "descrformal": "AG-Historical Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "HST-AS", "descr": "AS-Historical Analysis", "descrformal": "AS-Historical Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(HA-AG), (HST-AS)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1166, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/04/2027", "endDt": "01/22/2027", "instructors": [], "pattern": "", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Winter Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/04/2027", "endDt": "01/22/2027", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "HA-AG", "descr": "AG-Historical Analysis", "descrformal": "AG-Historical Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "HST-AS", "descr": "AS-Historical Analysis", "descrformal": "AS-Historical Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "HIST", "catalogNbr": "3410", "type": "B"}], "sessionCode": "WS", "sessionBeginDt": "01/04/2027", "sessionEndDt": "01/23/2027", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "This course examines United States history from the 1960s to the post-Covid-19 world we now inhabit. We will seek to better understand and interpret the meaning of the rapid transformations in American politics, economics, and culture in recent decades that have (at times) produced crises and disruptions in everyday life, as well as great achievements and accomplishments. We will pay particular attention to the social movements that have emerged in recent decades, including the struggle for African-American civil rights and equality, feminism and the changing roles of women, activism related to climate change and political reform, and the agency of ordinary people seeking to engage in meaningful social change. In addition, students will have the opportunity to evaluate a few different theoretical orientations and methodologies historians often use in practicing their craft. At a time when we seem to have limitless access to historical information (and misinformation) at our fingertips, we will examine the profound difference between and historical information and historical knowledge, with the goal of better understanding where the discipline (and our society) is heading in the 21st Century. (HIST-HNA)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026WI, 2025WI, 2015SP, 2010SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLoc