munity-based.  The visual culture of colonial Latin America can reveal multitudes on the construction of self and community across temporal and geographical contexts.  We will explore a variety of colonial Latin American objects and images, including paintings, textiles, and material culture.  Our discussions of images will be guided by readings on hybridity, coloniality, cross-cultural exchange, and the early modern Atlantic world.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2025FA, 2023SP, 2021SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2937, "crseId": 369433, "crseOfferNbr": 3, "subject": "LATA", "catalogNbr": "7250", "titleShort": "Time & History Ancient Mexico", "titleLong": "Time and History in Ancient Mexico", "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "LAAREA", "descr": "Latin American Studies Area", "descrformal": "Latin American Studies Area", "attrDescr": "Exploratory Studies", "attrDescrShort": "ExplStudy"}], "crseAttrValueGroups": [{"attrDescr": "Exploratory Studies", "crseAttrValues": "(LAAREA)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 17949, "meetings": [{"classMtgNbr": 1, "timeStart": "11:15AM", "timeEnd": "01:45PM", "startDt": "08/24/2026", "endDt": "12/07/2026", "instructors": [{"instrAssignSeq": 1, "netid": "jsh6", "firstName": "John", "middleName": "S.", "lastName": "Henderson"}], "pattern": "M", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "08/24/2026", "endDt": "12/19/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0004", "crseAttrValue": "LAAREA", "descr": "Latin American Studies Area", "descrformal": "Latin American Studies Area", "attrDescr": "Area Studies", "attrDescrShort": "Area Std"}], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ANTHR", "catalogNbr": "4256", "type": "B"}, {"subject": "ANTHR", "catalogNbr": "7250", "type": "B"}, {"subject": "ARKEO", "catalogNbr": "4256", "type": "B"}, {"subject": "ARKEO", "catalogNbr": "7250", "type": "B"}, {"subject": "LATA", "catalogNbr": "4250", "type": "B"}, {"subject": "RELST", "catalogNbr": "4256", "type": "B"}, {"subject": "RELST", "catalogNbr": "7250", "type": "B"}], "sessionCode": "1", "sessionBeginDt": "08/24/2026", "sessionEndDt": "12/19/2026", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "Explores the ways Mesoamericans understood the world and their place in it, and the ways they constructed history as these are reflected in the few books that have survived from the period before the European invasion. Examines the structure of writing and systems of notation, especially calendars, and considers their potential for illuminating Mesoamerican world views and approaches to history. Primary focus is detailed analysis of five precolumbian books: Codex Borgia, a central Mexican manual of divinatory ritual; Codex Boturini, a history of migration in central Mexico; Codex Nuttall, a Mixtec dynastic history; and two Maya books of astrology and divination, Codex Dresden and Codex Madrid.", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026FA, 2024FA, 2021FA, 2019FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-10-15T19:07:30-0400"}}