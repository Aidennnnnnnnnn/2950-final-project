seAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "FWS: Apocalyptic Fictions", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/24/2024", "sessionEndDt": "08/06/2024", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "What does it mean to be a \"good\" reader or a \"good\" writer in college? In each section of this course, students receive extensive guidance from their instructors in the discovery and practice of helpful methods for fully exploring and appreciating what they read as well as guidance in planning, drafting, and writing essays about what is read and discussed in class. Each section of the course focuses on a particular topic drawn from a range of fields (e.g., literature, history, film, music). Reading assignments are limited in order to allow ample time for discussion and for personal attention to student writing.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 352756, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "2800", "titleShort": "Creative Writing", "titleLong": "Creative Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent":