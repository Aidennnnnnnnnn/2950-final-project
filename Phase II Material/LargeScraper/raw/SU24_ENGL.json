 null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Spring, Summer.", "catalogComments": "ENGL 2800 cannot be counted towards the English major. Students should not take an FWS and ENGL 2800 in the same semester. ENGL 2800 is the prerequisite for 3000-level creative writing courses. This course can be used to fulfill distribution requirements in the humanities for Arts &amp; Sciences and most other colleges.", "catalogPrereqCoreq": "Prerequisite: completion of a First-Year Writing Seminar (FWS) course.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "Required for the Creative Writing minor.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 371618, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "3245", "titleShort": "Evil: Lit Question of Human", "titleLong": "Evil: The Literary Question of the Human", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1204, "meetings": [{"classMtgNbr": 1, "timeStart": "01:00PM", "timeEnd": "03:45PM", "startDt": "06/03/2024", "endDt": "06/21/2024", "instructors": [{"instrAssignSeq": 5, "netid": "pal37", "firstName": "Philip", "middleName": "", "lastName": "Lorenz"}], "pattern": "MTWRF", "facilityDescr": "Goldwin Smith Hall 348", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH348", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/03/2024", "endDt": "06/21/2024", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W1", "sessionBeginDt": "06/03/2024", "sessionEndDt": "06/21/2024", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "This course is designed to explore the relationship between ethics, politics, and aesthetics through careful attention to literary explorations of the complex problem of evil in a range of literary and visual texts including genres from myth through poetry and drama to painting and film. We will read and study excerpts of works from Aristotle, Augustine, and Thomas Aquinas, through Shakespeare, Cervantes, Mar\u00eda de Zayas, Leibniz, Milton, Hieronymous Bosch, and Krzysztof Kie\u015blowski. The recurring questions for us along the way will be about the role of reading and interpretation in relation to the problem of evil and what the philosopher Paul Ricoeur calls the \"richness of the real.\" This class may be used toward the pre-1800 requirement for English majors.", "catalogBreadth": "", "catalogDistr": "(ALC-AS, LA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall or Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "This course may be used toward the pre-1800 requirement for English majors.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2874, "crseId": 352977, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "4950", "titleShort": "Independent Study", "titleLong": "Independent Study", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "IND", "ssrComponentLong": "Independent Study", "section": "601", "classNbr": 2188, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/24/2024", "endDt": "07/15/2024", "instructors": [{"instrAssignSeq": 5, "netid": "esa52", "firstName": "Elizabeth", "middleName": "", "lastName": "Anker"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/24/2024", "endDt": "07/15/2024", "addConsent": "I", "addConsentDescr": "Instructor Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "IS", "instrModeDescrshort": "Indp Stds", "instrModeDescr": "Independent Studies", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["IND"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/28/2024", "sessionEndDt": "08/17/2024", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": []}], "description": "Independent reading course in topics not covered in regularly scheduled courses. Students select a topic in consultation with the faculty member who has agreed to supervise the course work.",