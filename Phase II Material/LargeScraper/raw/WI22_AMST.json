ades only", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "2260", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "2260", "type": "C"}, {"subject": "SHUM", "catalogNbr": "2260", "type": "C"}], "sessionCode": "WS", "sessionBeginDt": "01/03/2022", "sessionEndDt": "01/21/2022", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "In this class, we will examine how musicians working in such genres as rock, jazz, folk, classical, soul, and experimental music responded and contributed to the major themes of the 1960s in the US: the counterculture, Vietnam, the civil rights movement, women's liberation, and the space race. We will examine written texts, recordings, and films from the period. The ability to read music is not required.", "catalogBreadth": "", "catalogDistr": "(CA-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2804, "crseId": 370853, "crseOfferNbr": 2, "subject": "AMST", "catalogNbr": "2371", "titleShort": "Global Hip Hop", "titleLong": "Planet Rap: Where Hip Hop Came From and Where It's Going", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1124, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/03/2022", "endDt": "01/21/2022", "instructors": [{"instrAssignSeq": 4, "netid": "cma249", "firstName": "Catherine", "middleName": "M.", "lastName": "Appert"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Winter Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ws/courses/courses.php?v=3335"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/03/2022", "endDt": "01/21/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "ASRC", "catalogNbr": "2370", "type": "C"}, {"subject": "MUSIC", "catalogNbr": "2370", "type": "C"}], "sessionCode": "WS", "sessionBeginDt": "01/03/2022", "sessionEndDt": "01/21/2022", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "Since hip hop first emerged in the South Bronx nearly half a century ago, it has grown into a global movement. Youth around the world not only consume hip hop; they also create their own, adapting hip hop music, texts, dance, and visual culture to local realities. This course traces the ongoing connections between hip hop's roots in the cultural expression of marginalized African American and Latinx youth in the postindustrial urban United States, its contemporary relationship to US popular culture, and its routes around the globe, where diverse practitioners mobilize its beats, rhymes, and visual culture to address experiences of oppression and displacement, celebrate life, and agitate for social justice.", "catalogBreadth": "", "catalogDistr": "(CA-AS, ALC-AS, SCD-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "Forbidden Overlap: due to an overlap in content, students will receive credit for only one course in the following group: AMST 2371, ASRC 2370, MUSIC 2370, MUSIC 3490.", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2804, "crseId": 351417, "crseOfferNbr": 2, "subject": "AMST", "catalogNbr": "3141", "titleShort": "Prisons", "titleLong": "Prisons", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1127, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "01/03/2022", "endDt": "01/21/2022", "instructors": [{"instrAssignSeq": 1, "netid": "mcs378", "firstName": "Matthew", "middleName": "C", "lastName": "Saleh"}], "pattern": "", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "https://sce.cornell.edu/courses/programs/winter?v=3400"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "01/03/2022", "endDt": "01/21/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "3141", "type": "C"}], "sessionCode": "WS", "sessionBeginDt": "01/03/2022", "sessionEndDt": "01/21/2022", "sessionLong": "Winter Session", "exploreCriteriaIds": []}], "description": "The United States stands alone among Western, industrialized countries with its persistent, high rates of incarceration, long sentences, and continued use of the death penalty. This \"American exceptionalism\" -- the turn to mass incarceration -- has been fostered by the use of sharply-delineated categories that define vast numbers of people as outlaws and others as law-abiding. These categories that are based on ideas of personal responsibility and\u00a0assumptions about race are modified somewhat by a liberal commitment to human rights.\u00a0\u00a0 Our purpose in this course is to understand how such ideas have taken root and to locate the consequences of these ideas for policy and practice.\u00a0", "catalogBreadth": "", "catalogDistr": "(SBA-AS, SSC-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Winter, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-02-07T19:27:30-0500", "catalogDttm": "2022-02-07T19:14:23-0500"}}