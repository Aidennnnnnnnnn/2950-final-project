 "startDt": "06/01/2026", "endDt": "06/18/2026", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [{"crseAttr": "0009", "crseAttrValue": "PCONLINE", "descr": "Precollege Online", "descrformal": "Precollege Studies Online Program", "attrDescr": "School of Continuing Education", "attrDescrShort": "SCE"}, {"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "GLC-AS", "descr": "AS-Global Citizenship", "descrformal": "AS-Global Citizenship", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "SBA-AG", "descr": "AG-Social & Behvl Analysis", "descrformal": "AG-Social and Behavioral Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "SSC-AS", "descr": "AS-Social Sciences", "descrformal": "AS-Social Sciences", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "ASIAN", "catalogNbr": "3395", "type": "B"}, {"subject": "GOVT", "catalogNbr": "3967", "type": "B"}], "sessionCode": "3W1", "sessionBeginDt": "06/01/2026", "sessionEndDt": "06/18/2026", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "China is often thought of as being isolated from the outside world. It is imagined as existing in historic seclusion, and, following the establishment of the People's Republic, as pursuing a path of autarky. Such separation has then only been somewhat modified by the set of economic reforms that Deng Xiaoping first instituted in the late 1970s. In this lecture we will seek to turn such conventional wisdom on its head through examining what China is via a consideration of transnational currents within the country's development. However, the course's primary focus will not be upon the past, but rather the present and attempting to determine just where the point of intersection between China and the rest of the world is. Coming to terms with such an issue will provide those who enroll in the class with a deeper, more nuanced, understanding of China's rise and this trend's implications for the rest of the world. We will accomplish this task through a combination of surveying the existing literature on China and transnational politics, and considering new theoretical perspectives on both. (SC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025FA, 2025SP, 2021FA", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2026-08-16T19:07:12-0400"}}