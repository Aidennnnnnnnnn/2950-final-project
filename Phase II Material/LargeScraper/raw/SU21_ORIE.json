": "MTWRF", "facilityDescr": "Bloomberg Center 61X", "bldgDescr": "Bloomberg Center", "facilityDescrshort": "BLM61X", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Taught in NYC. Enrollment Limited to Cornell Tech Students Only via application."}], "campus": "NYT", "campusDescr": "New York Tech Campus", "location": "NYCTECH", "locationDescr": "Cornell Tech", "startDt": "05/27/2021", "endDt": "06/21/2021", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "HY", "instrModeDescrshort": "HY-OLIP", "instrModeDescr": "Hybrid-Online and In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/31/2021", "sessionEndDt": "08/21/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "Optimization models and methods are used to make businesses more efficient and cost effective. In this class, we will learn how to build and solve optimization models to make both strategic and operational decisions, and how to use data effectively to implement these models. We will cover business applications and problems such as pricing (how to price a product for retail?), choice modeling (how to estimate customers preferences in an online retail platform?), facility location (where to open warehouses and fulfillment centers?) and matching problems (how to match drivers to riders for example in the ride-sharing business?). The class will discuss both discrete optimization models that are used for instance in matching problems, and continuous optimization models that used for instance in pricing.", "catalogBreadth": "", "catalogDistr": "", "