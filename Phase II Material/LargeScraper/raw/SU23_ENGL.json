ldwin Smith Hall", "facilityDescrshort": "GSH236", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Intended for students participating in the Pre-Collegiate Summer Scholars Program. This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=599"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/28/2023", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/20/2023", "sessionEndDt": "08/01/2023", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "What does it mean to be a \"good\" reader or a \"good\" writer in college? In each section of this course, students receive extensive guidance from their instructors in the discovery and practice of helpful methods for fully exploring and appreciating what they read as well as guidance in planning, drafting, and writing essays about what is read and discussed in class. Each section of the course focuses on a particular topic drawn from a range of fields (e.g., literature, history, film, music). Reading assignments are limited in order to allow ample time for discussion and for personal attention to student writing.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 352638, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "1132", "titleShort": "FWS:The Personal Essay", "titleLong": "FWS:The Personal Essay", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1132, "meetings": [{"classMtgNbr": 1, "timeStart": "08:30AM", "timeEnd": "09:45AM", "startDt": "06/20/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 6, "netid": "kda24", "firstName": "Kevin", "middleName": "D.", "lastName": "Attell"}], "pattern": "MTWRF", "facilityDescr": "Goldwin Smith Hall 236", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH236", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=600"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/28/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/20/2023", "sessionEndDt": "08/01/2023", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}, {"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "102", "classNbr": 1133, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "11:15AM", "startDt": "06/20/2023", "endDt": "07/28/2023", "instructors": [{"instrAssignSeq": 6, "netid": "tcc9", "firstName": "Timothy", "middleName": "C.", "lastName": "Campbell"}], "pattern": "MTWRF", "facilityDescr": "White Hall B02", "bldgDescr": "White Hall", "facilityDescrshort": "WHTB02", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=600"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/20/2023", "endDt": "07/28/2023", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["SEM"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/20/2023", "sessionEndDt": "08/01/2023", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "In \"The Personal Essay,\" our topics are autobiographical in their origins; we write from personal experience, to think about it and to articulate it, in a style useful in all modes of college-admission and college-work. Our writing practice is both \"creative\" and \"analytical.\" We discover how writers use drafting and revision as a process of thinking, and in weekly workshops we practice the kind of revision that can make us more independent as writers and more capable of giving helpful suggestions to friends who are also writers. The most important texts for the course are the essays of students enrolled in it; but we also read and discuss personal memoirs. This seminar offers students from diverse backgrounds a forum in which to move beyond accustomed boundaries, finding agency not only through use of the first-person voice but through increased confidence in their abilities as writers.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "First-Year Writing Seminar.", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2846, "crseId": 352756, "crseOfferNbr": 1, "subject": "ENGL", "catalogNbr": "2800", "titleShort": "Creative Writing", "titleLong": "Creative Writing", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "SEM", "ssrComponentLong": "Seminar", "section": "101", "classNbr": 1135, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "12:45PM", "startDt": "05/30/2023", "endDt": "06/16/2023", "instructors": [{"instrAssignSeq": 7, "netid": "eq25", "firstName": "Ernesto", "middleName": "", "lastName": "Quinonez"}], "pattern": "MTWRF", "facilityDescr": "Online Meeting", "bldgDescr": "Virtual", "facilityDescrshort": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For