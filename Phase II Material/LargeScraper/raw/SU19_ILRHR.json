is course covers current topics in HRM that have resulted from environmental and organizational challenges (e.g., technology, globalization, legislation, restructuring, work/life balance, changing labor markets). Emphasis is placed on developing relevant problem-solving and critical-thinking skills, as the basic concepts of HRM and the skills developed in this course are applicable to all types of organizations and jobs in which students will eventually work.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, winter, spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 350277, "crseOfferNbr": 1, "subject": "ILRHR", "catalogNbr": "2660", "titleShort": "Essential Desktop Applications", "titleLong": "Essential Desktop Applications", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1473, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "10:45AM", "startDt": "05/29/2019", "endDt": "06/21/2019", "instructors": [{"instrAssignSeq": 2, "netid": "cmg4", "firstName": "Christina", "middleName": "M.", "lastName": "Homrighouse"}], "pattern": "MTWRF", "facilityDescr": "Ives Hall 118", "bldgDescr": "Ives Hall", "facilityDescrshort": "IVS118", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=1422"}], "campus": "MAIN", "campusDescr": "Ithaca",