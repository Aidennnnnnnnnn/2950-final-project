th the metrics that are reported in income statements, balance sheets, and cash flow statements, and how they relate to each other. You will also learn how comparing numbers across your company and the industry from year to year can help you assess the overall financial performance of the firm.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: students enrolled in the Executive Master of Human Resource Management.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "IL", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2734, "crseId": 367571, "crseOfferNbr": 1, "subject": "ILRHR", "catalogNbr": "8903", "titleShort": "Case Project: Final Report", "titleLong": "Case Project: Final Report and Presentation", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1797, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/03/2019", "endDt": "07/26/2019", "instructors": [{"instrAssignSeq": 1, "netid": "cjc53", "firstName": "Chris", "middleName": "J.", "lastName": "Collins"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "Enrollment limited to students in the Executive Master of Human Resource Management program."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/03/2019", "endDt": "07/26/2019", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": tr