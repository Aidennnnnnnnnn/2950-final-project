n to wavelets and elementary convex analysis.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: MATH 2930, MATH 2940, and ECE 2200/ENGRD 2220\u00a0or permission of instructor.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Deepen their understanding of fundamental concepts from real analysis and linear algebra to which they have been exposed in their calculus and differential equation courses by putting them to work in an engineering context.", "Achieve a sophisticated understanding of fundamental signals and systems concepts, a few of which they have been exposed to on an elementary level in ECE 2200, by learning the mathematics behind them.", "Attain an appreciation of the central role that advanced mathematics plays in modeling, analysis, and design of engineering systems."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 364322, "crseOfferNbr": 1, "subject": "ECE", "catalogNbr": "4990", "titleShort": "International Research Intern", "titleLong": "International Research Internship", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "RSC", "ssrComponentLong": "Research", "section": "701", "classNbr": 1689, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/28/2018", "endDt": "08/07/2018", "instructors": [{"instrAssignSeq": 1, "netid": "at422", "firstName": "A. Kevin", "middleName": "", "lastName": "Tang"}], "pattern": "", "facilityDescr": null, "bldgDescr": null, "facilityDescrshort": null, "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locat