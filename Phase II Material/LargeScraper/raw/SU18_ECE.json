], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Two-semester Design Project: must enroll in both semesters; receive R grade for first semester. For students enrolled in M.Eng. (Electrical and Computer Engineering) degree program. Uses real engineering situations to present fundamentals of engineering design. Each professor is assigned a section for the fall and spring. Students who do not complete the Design Project in the spring receive a grade only for the work completed up to the point of the required submission date, which is the last day of Finals Week. Students must then enroll for the summer with the ECE M.Eng. director to complete the work remaining for the design project.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GR", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2018-09-16T19:14:21-0400", "catalogDttm": "2018-06-14T19:15:33-0400"}}