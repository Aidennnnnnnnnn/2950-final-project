 "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "07/05/2018", "endDt": "08/15/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": false, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": null, "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC", "DIS"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/30/2018", "sessionEndDt": "08/07/2018", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": null}], "description": "Covers static, quasi-static, and dynamic electromagnetic fields and waves. Topics include Maxwell's equations (integral and differential forms), fields of charge and current distributions, boundary conditions, fields near conductors, method of images, material polarization and dielectrics; energy, work, and power in electromagnetic systems; wave propagation and polarization, waves in media (dielectrics, conductors, and anisotropic materials); reflection, transmission, and refraction at media interfaces; guided waves in transmission lines, Smith charts, transients; metallic and dielectric waveguides; radiation and antennas, antenna arrays, electric circuits for transmission and reception, aperture antennas and diffraction.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, summer.", "catalogComments": "", "catalogPrereqCoreq": "Prerequisite: PHYS 2213,\u00a0 MATH 2930, and ECE 2100/ENGRD 2100.", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": ["Be able to use vector calculus to solve Maxwell's Equations describing the electromagnetic\r\nstatic and dynamic fields in a variety of geometries and coordinate systems.", "Be able to analyze electromagnetic wave propagation in free space and in different\r\nmaterials.", "Be able to analyze electromagnetic wave propagation through guiding structures\r\n(metal and dielectric waveguides and transmission lines) under various loading\r\nconditions, and design impedance matching circuits for optimum power transfer.", "Be able to analyze and design wire antennas, arrays and dishes."], "acadCareer": "UG", "acadGroup": "EN", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2699, "crseId": 358889, "crseOfferNbr": 1, "subject": "ECE", "catalogNbr": "3250", "titleShort": "Math of Signal & Sys Analysis", "titleLong": "Mathematics of Signal and System Analysis", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1145, "meetings": [{"classMtgNbr": 1, "timeStart": "10:00AM", "timeEnd": "11:15AM", "startDt": "05/24/2018", "endDt": "07/04/2018", "instructors": [{"instrAssignSeq": 2, "netid": "cbp8", "firstName": "Carl", "middleName": "", "lastName": "Poitras"}], "pattern": "MTWRF", "facilityDescr": "Phillips Hall 403", "bldgDescr": "Phillips Hall", "facilityDescrshort": "PHL403", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=2782"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/24/2018", "endDt": "07/04/2018", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort"