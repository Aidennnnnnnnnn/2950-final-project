t": "Online", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Online Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3464"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/21/2022", "endDt": "08/02/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "AD", "instrModeDescrshort": "DL-AD", "instrModeDescr": "Distance Learning-Asynchronous", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [{"subject": "COGST", "catalogNbr": "1101", "type": "C"}, {"subject": "CS", "catalogNbr": "1710", "type": "C"}, {"subject": "LING", "catalogNbr": "1170", "type": "C"}, {"subject": "PSYCH", "catalogNbr": "1102", "type": "C"}], "sessionCode": "6WK", "sessionBeginDt": "06/21/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "This course provides an introduction to the science of the mind. Everyone knows what it's like to think and perceive, but this subjective experience provides little insight into how minds emerge from physical entities like brains. To address this issue, cognitive science integrates work from at least five disciplines: Psychology, Neuroscience, Computer Science, Linguistics, and Philosophy. This course introduces students to the insights these disciplines offer into the workings of the mind by exploring visual perception, attention, memory, learning, problem solving, language, and consciousness.\u00a0", "catalogBreadth": "", "catalogDistr": "(KCM-AS, ETM-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Spring, Summer.", "catalogComments": "A 1 credit Writing in the Majors sections is available,\u00a0PHIL 1621.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}, {"strm": 2818, "crseId": 353857, "crseOfferNbr": 1, "subject": "PHIL", "catalogNbr": "2300", "titleShort": "Puzzles and Paradoxes", "titleLong": "Puzzles and Paradoxes", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1673, "meetings": [{"classMtgNbr": 1, "timeStart": "02:30PM", "timeEnd": "03:45PM", "startDt": "06/21/2022", "endDt": "07/29/2022", "instructors": [{"instrAssignSeq": 4, "netid": "jw2682", "firstName": "James", "middleName": "", "lastName": "Walsh"}], "pattern": "MTWRF", "facilityDescr": "Goldwin Smith Hall 283", "bldgDescr": "Goldwin Smith Hall", "facilityDescrshort": "GSH283", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit http://www.sce.cornell.edu/ss/courses/courses.php?v=3483"}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/21/2022", "endDt": "07/29/2022", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/21/2022", "sessionEndDt": "08/02/2022", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "This course will survey a number of famous paradoxes about the nature of time, identity, logic, science, belief, decision, and value. Some of these paradoxes have widely accepted answers, but many do not. Paradoxes include (but are not limited to) Zeno's paradoxes, the sorites paradox, the liar paradox, paradoxes of probability, the doomsday and simulation arguments, Newcomb's puzzle, and the trolley problem. These paradoxes will be used as a stepping stone to deeper philosophical questions.\u00a0Some of the questions we'll tackle include: Is time real? What is a person? Is infinity coherent? How is science possible? What is knowledge? What is it to be rational? What should we do? Does God exist? And finally, why is death bad?", "catalogBreadth": "", "catalogDistr": "(KCM-AS, SMR-AS)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "lastTermsOffered": null, "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2022-09-01T07:41:12-0400", "catalogDttm": "2022-08-09T08:17:01-0400"}}