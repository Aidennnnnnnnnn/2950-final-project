25", "instructors": [], "pattern": "", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "05/27/2025", "endDt": "08/16/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 12, "componentsOptional": [], "componentsRequired": ["CLN"], "gradingBasis": "SUS", "gradingBasisShort": "Sat/Unsat", "gradingBasisLong": "Satisfactory/Unsatisfactory", "simpleCombinations": [], "sessionCode": "1", "sessionBeginDt": "05/27/2025", "sessionEndDt": "08/16/2025", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": []}], "description": "This course allows students, as externs to work full time at approved placement sites (most sites are non-profit organizations or governmental agencies) during the fall or spring semester of their third year or the spring semester of their second year.\u00a0 The course purpose is to provide a bridge between the study of law and its practice. The student must be supervised/mentored by an attorney and engage in meaningful and \"attorney-like\" work at the placement which furthers the student's education and career goals. In addition to work responsibilities for the placement, the extern will create a Learning Agenda, prepare weekly Journal entries, engage in a regular electronic Discussion Board with other externs and the instructor, possibly host the faculty director for a site visit, and do a written Description of Placement.\u00a0\u00a0", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": null, "catalogAttribute": "", "catalogWhenOffered": "Spring.", "catalogComments": "A written application for the course must be submitted to the instructor and approved during the semester preceding the semester the student plans to participate. This course also requires off premises travel for which the student is responsible for.", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "LA", "acadGroup": "LA", "lastTermsOffered": "2025FA, 2025SU, 2025SP, 2024FA", "exploreCriteriaIds": []}]}, "message": null, "meta": {"copyright": "Cornell University, Office of the University Registrar", "rosterDttm": "2025-10-15T19:07:41-0400", "catalogDttm": "2025-07-09T19:07:04-0400"}}