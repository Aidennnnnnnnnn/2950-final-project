{"status": "success", "data": {"classes": [{"strm": 2902, "crseId": 368788, "crseOfferNbr": 1, "subject": "LAW", "catalogNbr": "3887", "titleShort": "Int'l Human Rights Theo & Prac", "titleLong": "International Human Rights in Theory and Practice", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1427, "meetings": [{"classMtgNbr": 1, "timeStart": "10:15AM", "timeEnd": "11:15AM", "startDt": "06/23/2025", "endDt": "07/11/2025", "instructors": [{"instrAssignSeq": 4, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "meetingTopicDescription": ""}, {"classMtgNbr": 2, "timeStart": "11:30AM", "timeEnd": "12:30PM", "startDt": "06/23/2025", "endDt": "07/11/2025", "instructors": [{"instrAssignSeq": 4, "netid": "eb456", "firstName": "Elizabeth", "middleName": "", "lastName": "Brundige"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "ITH", "locationDescr": "Ithaca, NY (Main Campus)", "startDt": "06/23/2025", "endDt": "07/11/2025", "addConsent": "N", "addConsentDescr": "No Special Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "OL", "instrModeDescrshort": "OL", "instrModeDescr": "Online", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "GRD", "gradingBasisShort": "Graded", "gradingBasisLong": "Letter grades only", "simpleCombinations": [{"subject": "GOVT", "catalogNbr": "3887", "type": "C"}], "sessionCode": "3W2", "sessionBeginDt": "06/23/2025", "sessionEndDt": "07/11/2025", "sessionLong": "Three Week - Second", "exploreCriteriaIds": []}], "description": "This course will introduce students to the law, theory, and practice of international human rights. Students will think critically about the effectiveness of the\u00a0international human rights system by examining its successes, failures, and dilemmas in preventing and responding to human rights abuse. Topics covered will include the origins and foundations of international human rights; the role of international, regional,\u00a0and domestic institutions and actors in enforcing human rights; critiques of the human rights movement; and the relationship of the\u00a0United States to the international system for the protection of human rights. The course will also explore issues such as the\u00a0death penalty, women's human rights, migration, climate change, global poverty, racism and xenophobia, and responses to mass atrocities. During in-class activities, students will have the opportunity to step into the shoes of a human rights advocate and work\u00a0with their classmates to address simulated human rights problems.", "catalogBreadth": null, "catalogDistr": "(CA-AG)", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": null, "catalogAttribute": "(CU-SBY)", "catalogWhenOffered": "Spring.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "LA", "lastTermsOffered": "2025SU, 2024SU, 2024WI, 2023SU", "exploreCriteriaIds": []}, {"strm": 2902, "crseId": 370207, "crseOfferNbr": 1, "subject": "LAW", "catalogNbr": "4031", "titleShort": "Intro to Global Study of Law", "titleLong": "Introduction to the Global Study of Law", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1908, "meetings": [{"classMtgNbr": 1, "timeStart": "09:00AM", "timeEnd": "05:00PM", "startDt": "06/23/2025", "endDt": "07/11/2025", "instructors": [{"instrAssignSeq": 6, "netid": "esa52", "firstName": "Elizabeth", "middleName": "", "lastName": "Anker"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/courses/roster."}], "campus": "MAIN", "campusDescr": "Ithaca", "location": "PARIS", "locationDescr": "Paris, France", "startDt": "06/23/2025", "endDt": "07/11/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 4, "unitsMaximum": 4, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "SP2", "sessionBeginDt": "05/27/2025", "sessionEndDt": "08/16/2025", "sessionLong": "Summer Special Session 2", "exploreCriteriaIds": []}], "description": "This three-part course is designed to introduce advanced prelaw students to key topics in the study and practice of law, within a global context. Its units are organized around three sets of issues. First, how do U.S. law and legal institutions relate to legal cultures from around the world; and how does one analyze different national and international legal systems from a comparative and cross-cultural perspective?\u00a0Second, what is the role of constitutional law and principles both within the U.S. and globally? Third, what are the main challenges confronting international human rights, including their ability to protect traditionally disadvantaged groups such as women? Taught entirely by faculty of Cornell Law School, this course will prepare prelaw students for success in law school.", "catalogBreadth": null, "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": null, "catalogAttribute": "", "catalogWhenOffered": "Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": null, "catalogSatisfiesReq": "", "catalogPermission": "", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "LA", "lastTermsOffered": "2025SU, 2024SU, 2023SU, 2022SU", "exploreCriteriaIds": []}, {"strm": 2902, "crseId": 374825, "crseOfferNbr": 1, "subject": "LAW", "catalogNbr": "6164", "titleShort": "Comparative EU/US Regulation", "titleLong": "Comparative EU and US Regulation: AI, Climate Change, and Antitrust", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1954, "meetings": [{"classMtgNbr": 1, "timeStart": "03:00PM", "timeEnd": "04:30PM", "startDt": "07/03/2025", "endDt": "07/18/2025", "instructors": [{"instrAssignSeq": 1, "netid": "js2758", "firstName": "Jed", "middleName": "", "lastName": "Stiglitz"}], "pattern": "MTWRF", "meetingTopicDescription": ""}], "notes": [], "campus": "MAIN", "campusDescr": "Ithaca", "location": "PARIS", "locationDescr": "Paris, France", "startDt": "07/03/2025", "endDt": "07/18/2025", "addConsent": "D", "addConsentDescr": "Department Consent Required", "isComponentGraded": true, "crseAttrs": [], "instructionMode": "P", "instrModeDescrshort": "In Person", "instrModeDescr": "In Person", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 1, "unitsMaximum": 1, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt"