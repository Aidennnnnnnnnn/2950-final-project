], "gradingBasis": "SUI", "gradingBasisShort": "S/U NoAud", "gradingBasisLong": "Satisfactory/Unsatisfactory (no audit)", "simpleCombinations": [{"subject": "NBAY", "catalogNbr": "5700", "type": "C"}], "sessionCode": "1", "sessionBeginDt": "05/31/2021", "sessionEndDt": "08/21/2021", "sessionLong": "Regular Academic Session", "exploreCriteriaIds": null}], "description": "This course is designed to provide you with instruction and experience in leading and contributing to high-performing teams that: (1) set clear goals and objectives; (2) develop, implement, and enforce appropriate internal team norms; (3) effectively collaborate, taking maximum advantage of diverse strengths and backgrounds; (4) produce well-reasoned analyses of complex business problems; and, (5) provide team members with appropriate constructive feedback from which further growth and development can occur.", "catalogBreadth": "", "catalogDistr": "", "catalogEnrollmentPriority": null, "catalogLang": "", "catalogForbiddenOverlaps": "", "catalogAttribute": "", "catalogWhenOffered": "Fall, Summer.", "catalogComments": "", "catalogPrereqCoreq": "", "catalogPrereq": null, "catalogCoreq": null, "catalogFee": "", "catalogSatisfiesReq": "", "catalogPermission": "Enrollment limited to: Johnson School students.", "catalogCourseSubfield": "", "catalogOutcomes": null, "acadCareer": "GM", "acadGroup": "BU", "lastTermsOffered": null, "exploreCriteriaIds": null}, {"strm": 2790, "crseId": 363060, "crseOfferNbr": 1, "subject": "NBA", "catalogNbr": "5911", "titleShort": "Risk Mgmt. in Emerging Markets", "titleLong": "Risk Management in Emerging Markets", "crseAttrs": [], "crseAttrValueGroups": [], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1085, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/21/2021", "endDt": "07/09/2021", "instructors": [{"instrAssignSeq": 4, "netid": "eai1", "firstName": "Elena", "middleNa