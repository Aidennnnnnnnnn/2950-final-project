ne", "topicDescription": "", "openStatus": "O", "exploreCriteriaIds": [], "materials": []}], "unitsMinimum": 3, "unitsMaximum": 3, "componentsOptional": [], "componentsRequired": ["LEC"], "gradingBasis": "OPT", "gradingBasisShort": "Stdnt Opt", "gradingBasisLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "3W1", "sessionBeginDt": "06/01/2026", "sessionEndDt": "06/18/2026", "sessionLong": "Three Week - First", "exploreCriteriaIds": []}], "description": "Can we identify a distinctive Asian food and food culture? Challenging attempts to define heterogenous gastronomic practices as authentic reflections of a static Asian identity, this course discusses how food, diet, and cuisine have been integral to shaping boundaries of culture, identity, and nation across geographical and temporal divisions in Asia. We will examine how people use daily and visceral food experiences to imagine themselves as members of a given community, be it a nation, ethnicity, class, gender, or religion, while also examining how food practices constantly challenge that fixation and redraw these categories. Through examining a wide range of materials in diverse disciplines, ranging from reading historical and anthropological studies to watching \u201cfood porn\u201d and TV cooking shows, we will discuss topics related to cookery and the media, colonialism and culinary modernity, food production and consumption, gender and cooking, food and (trans)nationalism, diaspora and globalization of food as well as eating and inequality. (SC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2026SP, 2025SP, 2024SP", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 367263, "crseOfferNbr": 3, "subject": "ASIAN", "catalogNbr": "3395", "titleShort": "What is China?", "titleLong": "What is China?", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "SBA-AG", "descr": "AG-Social & Behvl Analysis", "descrformal": "AG-Social and Behavioral Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "GLC-AS", "descr": "AS-Global Citizenship", "descrformal": "AS-Global Citizenship", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crseAttrValue": "SSC-AS", "descr": "AS-Social Sciences", "descrformal": "AS-Social Sciences", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}], "crseAttrValueGroups": [{"attrDescr": "Distribution Requirements", "crseAttrValues": "(CA-AG, SBA-AG), (GLC-AS, SSC-AS)"}], "enrollGroups": [{"classSections": [{"ssrComponent": "LEC", "ssrComponentLong": "Lecture", "section": "001", "classNbr": 1559, "meetings": [{"classMtgNbr": 1, "timeStart": "", "timeEnd": "", "startDt": "06/01/2026", "endDt": "06/18/2026", "instructors": [{"instrAssignSeq": 1, "netid": "arc26", "firstName": "Allen", "middleName": "R.", "lastName": "Carlson"}], "pattern": "", "meetingTopicDescription": ""}], "notes": [{"classNotesSeq": 1, "descrlong": "This Summer Session class is offered by the School of Continuing Education and Summer Sessions. For details visit: https://sce.cornell.edu/."}, {"classNotesSeq": 2, "descrlo