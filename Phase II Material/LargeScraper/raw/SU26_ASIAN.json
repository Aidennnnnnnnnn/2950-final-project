isLong": "Letter or S/U grades", "simpleCombinations": [], "sessionCode": "6WK", "sessionBeginDt": "06/22/2026", "sessionEndDt": "08/04/2026", "sessionLong": "Six Week Summer", "exploreCriteriaIds": []}], "description": "This course will examine various literary, historical, and political responses to the Cambodian genocide, particularly literary testimony by survivors and governmental efforts to bring the perpetrators to justice. The course considers the limited effectiveness of these responses for addressing the causes and effects of genocide despite the vow of \"never again.\" To pursue these questions, students will read selections from novels and poetry written by Cambodian survivors, along with historical accounts of the genocide and analysis attempts by the Cambodian government and the international community to bring the perpetrators to justice. (SC)", "catalogBreadth": null, "catalogDistr": null, "catalogEnrollmentPriority": "", "catalogLang": null, "catalogForbiddenOverlaps": null, "catalogAttribute": null, "catalogWhenOffered": null, "catalogComments": null, "catalogPrereqCoreq": null, "catalogPrereq": "", "catalogCoreq": "", "catalogFee": null, "catalogSatisfiesReq": null, "catalogPermission": null, "catalogCourseSubfield": null, "catalogOutcomes": null, "acadCareer": "UG", "acadGroup": "AS", "catalogName": null, "catalogNextOffered": null, "lastTermsOffered": "2026SU, 2025SU, 2024SU, 2023SU", "catalogCredits": null, "catalogGradeOption": null, "catalogLocation": null, "catalogCrosslisted": null, "catalogCrosslistings": null, "catalogComeets": null, "exploreCriteriaIds": []}, {"strm": 2930, "crseId": 373526, "crseOfferNbr": 1, "subject": "ASIAN", "catalogNbr": "2272", "titleShort": "Food and Asia", "titleLong": "Food and Asia", "crseAttrs": [{"crseAttr": "0012", "crseAttrValue": "CA-AG", "descr": "AG-Cultural Analysis", "descrformal": "AG-Cultural Analysis", "attrDescr": "Distribution Requirements", "attrDescrShort": "DistReq"}, {"crseAttr": "0012", "crs